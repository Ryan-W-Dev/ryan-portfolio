---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, site);
const socialImageUrl = new URL('/assets/hero/hero-desert.webp', site);
---

<!doctype html>
<html lang="en" data-intro-pending>
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#061c38" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Ryan Wynn" />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1080" />
		<meta
			property="og:image:alt"
			content="Ryan Wynn extreme-sports portfolio artwork"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link
			rel="preload"
			as="image"
			href="/assets/freefall/freefall-environment-mobile.webp"
			media="(max-width: 64rem)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/assets/freefall/freefall-environment.webp"
			media="(min-width: 64.001rem)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/assets/hero/hero-desert.webp"
			fetchpriority="high"
		/>
		<style is:inline>
			html[data-intro-pending] {
				overflow: hidden;
				background: #061c38;
			}

			html[data-intro-pending] body {
				overflow: hidden;
				background: #061c38;
			}

			html[data-intro-pending] [data-freefall-intro] {
				position: fixed;
				z-index: 1000;
				inset: 0;
				inline-size: 100vw;
				block-size: 100vh;
				block-size: 100lvh;
				min-block-size: 100dvh;
				overflow: hidden;
				background: transparent;
				opacity: 1;
				visibility: visible;
			}

			html[data-intro-pending] [data-freefall-world] {
				position: absolute;
				inset: 0;
				overflow: hidden;
				background: #0759b6 url('/assets/freefall/freefall-environment.webp')
					center / cover no-repeat;
			}

			html[data-intro-pending] [data-arrival-content],
			html[data-intro-pending] [data-scroll-indicator],
			html[data-intro-pending] [data-social-flight],
			html[data-intro-pending] [data-dirt-bike-guide] {
				opacity: 0;
				visibility: hidden;
			}

			html[data-intro-pending]
				[data-freefall-intro]:not([data-intro-owner='gsap']) {
				animation: critical-intro-fail-open 0.2s ease-out 5.05s forwards;
			}

			html[data-intro-pending] {
				animation: critical-scroll-fail-open 1ms linear 5.25s forwards;
			}

			html[data-intro-pending] [data-arrival-content],
			html[data-intro-pending] [data-scroll-indicator],
			html[data-intro-pending] [data-social-flight] {
				animation: critical-content-fail-open 1ms linear 5.25s forwards;
			}

			@keyframes critical-intro-fail-open {
				to {
					opacity: 0;
					visibility: hidden;
				}
			}

			@keyframes critical-scroll-fail-open {
				to {
					overflow: auto;
				}
			}

			@keyframes critical-content-fail-open {
				to {
					opacity: 1;
					visibility: visible;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html[data-intro-pending]
					[data-freefall-intro]:not([data-intro-owner='gsap']) {
					animation-duration: 0.45s;
					animation-delay: 0.45s;
				}

				html[data-intro-pending] {
					animation-delay: 0.9s;
				}

				html[data-intro-pending] [data-arrival-content],
				html[data-intro-pending] [data-scroll-indicator],
				html[data-intro-pending] [data-social-flight] {
					animation-delay: 0.9s;
				}
			}

			@media (max-width: 64rem) {
				html[data-intro-pending] [data-freefall-world] {
					background-image: url('/assets/freefall/freefall-environment-mobile.webp');
				}
			}
		</style>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
