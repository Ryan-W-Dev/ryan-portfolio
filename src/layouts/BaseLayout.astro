---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, site);
const socialImageUrl = new URL('/assets/hero/hero-desert.webp', site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#061c38" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Ryan Wynn" />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1080" />
		<meta
			property="og:image:alt"
			content="Ryan Wynn extreme-sports portfolio artwork"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link
			rel="preload"
			as="image"
			href="/assets/freefall/freefall-environment-mobile.webp"
			media="(max-width: 40rem)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/assets/freefall/freefall-environment.webp"
			media="(min-width: 40.001rem)"
			fetchpriority="high"
		/>
		<link
			rel="preload"
			as="image"
			href="/assets/hero/hero-desert.webp"
			fetchpriority="high"
		/>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
