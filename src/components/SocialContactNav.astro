---
interface Contact {
	label: string;
	icon: 'email' | 'github' | 'linkedin' | 'telegram' | 'whatsapp';
	href: string;
}

const contacts: Contact[] = [
	{
		label: 'Email',
		icon: 'email',
		href: 'mailto:ryan.james.wynn@gmail.com',
	},
	{ label: 'GitHub', icon: 'github', href: 'https://github.com/Ryan-W-Dev' },
	{
		label: 'LinkedIn',
		icon: 'linkedin',
		href: 'https://www.linkedin.com/in/ryan-wynn-01a784403/',
	},
	{ label: 'Telegram', icon: 'telegram', href: 'https://t.me/ryanwynn4' },
	{
		label: 'WhatsApp',
		icon: 'whatsapp',
		href: 'https://wa.me/971508114541',
	},
];

const iconPaths: Record<Contact['icon'], string> = {
	email:
		'M3 5h18v14H3V5Zm2.2 2 6.8 5.1L18.8 7H5.2Zm13.8 2.5-7 5.2-7-5.2V17h14V9.5Z',
	github:
		'M12 2.5a9.6 9.6 0 0 0-3 18.7c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.7-1.3-2.2-.3-4.6-1.1-4.6-4.8 0-1.1.4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 4.9 0c1.8-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.3 4.5-4.6 4.8.4.3.7.9.7 1.8v2.7c0 .4.2.6.7.5A9.6 9.6 0 0 0 12 2.5Z',
	linkedin:
		'M5.2 8.3H1.8V19h3.4V8.3Zm.2-3.4A2 2 0 1 0 1.5 5a2 2 0 0 0 3.9 0ZM22 12.9c0-3.2-1.7-4.9-4-4.9-1.9 0-2.7 1-3.1 1.8V8.3h-3.4V19h3.4v-5.3c0-1.4.3-2.8 2.1-2.8 1.8 0 1.8 1.7 1.8 2.9V19H22v-6.1Z',
	telegram:
		'm21.5 3.7-3 16c-.2 1.1-.9 1.4-1.8.9l-4.6-3.4-2.2 2.2c-.2.2-.5.5-1 .5l.3-4.7 8.6-7.8c.4-.3-.1-.5-.6-.2L6.6 13.9 2 12.4c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.3 1.7Z',
	whatsapp:
		'M12 2.4a9.5 9.5 0 0 0-8.1 14.4l-1.3 4.8 4.9-1.3A9.6 9.6 0 1 0 12 2.4Zm0 17.5c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.9 7.9 0 1 1 12 19.9Zm4.4-5.9c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.8-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4-.2.2-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.2.2-.6.2-1.1.2-1.2-.2-.2-.4-.3-.6-.4Z',
};
---

<nav class="social-flight" data-social-flight aria-label="Contact Ryan Wynn">
	<ul class="contact-list contact-list--compact" data-contact-compact>
		{
			contacts.map((contact) => (
				<li>
					<a
						class="contact-item"
						href={contact.href}
						target={contact.href.startsWith('mailto:') ? undefined : '_blank'}
						rel={
							contact.href.startsWith('mailto:')
								? undefined
								: 'noopener noreferrer'
						}
						aria-label={
							contact.href.startsWith('mailto:')
								? 'Email Ryan Wynn'
								: `${contact.label} — opens in a new tab`
						}
					>
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={iconPaths[contact.icon]} />
							</svg>
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<ul
		class="contact-list contact-list--footer"
		data-contact-footer-list
		aria-hidden="true"
		inert
	>
		{
			contacts.map((contact) => (
				<li>
					<a
						class="contact-item"
						href={contact.href}
						target={contact.href.startsWith('mailto:') ? undefined : '_blank'}
						rel={
							contact.href.startsWith('mailto:')
								? undefined
								: 'noopener noreferrer'
						}
						aria-label={
							contact.href.startsWith('mailto:')
								? 'Email Ryan Wynn'
								: `${contact.label} — opens in a new tab`
						}
					>
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={iconPaths[contact.icon]} />
							</svg>
						</span>
						<span class="contact-label">{contact.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	import { gsap } from 'gsap';
	type NavigationState = 'hero' | 'content' | 'footer';
	const FREEFALL_COMPLETE_EVENT = 'freefall:intro-complete';

	const socialWindow = window as Window & {
		__socialFlightCleanup?: () => void;
	};
	socialWindow.__socialFlightCleanup?.();

	const initialiseSocialFlight = () => {
		const nav = document.querySelector<HTMLElement>('[data-social-flight]');
		const compact = nav?.querySelector<HTMLElement>('[data-contact-compact]');
		const footerList = nav?.querySelector<HTMLElement>(
			'[data-contact-footer-list]',
		);
		const hero = document.querySelector<HTMLElement>('[data-arrival-scene]');
		const footer = document.querySelector<HTMLElement>('[data-contact-footer]');
		if (!nav || !compact || !footerList || !hero || !footer) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let transition: gsap.core.Timeline | undefined;
		let stateFrame = 0;
		let resizeFrame = 0;
		let settleFrame = 0;
		let currentState: NavigationState | undefined;
		let heroPosition = { x: 0, y: 0 };
		let contentPosition = { x: 0, y: 0 };
		let footerPosition = { x: 0, y: 0 };

		const setInteractiveState = (state?: NavigationState) => {
			const footerActive = state === 'footer';
			const compactActive = state === 'hero' || state === 'content';
			compact.toggleAttribute('inert', !compactActive);
			compact.setAttribute('aria-hidden', String(!compactActive));
			footerList.toggleAttribute('inert', !footerActive);
			footerList.setAttribute('aria-hidden', String(!footerActive));
			footerList.toggleAttribute('data-contact-active', footerActive);
			nav.toggleAttribute('data-footer-mode', footerActive);
		};

		const positionFor = (state: NavigationState) =>
			state === 'hero' ? heroPosition : contentPosition;

		const finishTransition = (state: NavigationState) => {
			delete nav.dataset.navTransitioning;
			gsap.set([compact, footerList], { willChange: 'auto' });
			setInteractiveState(state);
		};

		const applyState = (state: NavigationState, immediate = false) => {
			if (state === currentState && !immediate) return;
			transition?.kill();
			transition = undefined;
			const previousState = currentState;
			currentState = state;
			nav.dataset.navState = state;

			const compactPosition = positionFor(state);
			if (immediate || reducedMotion.matches) {
				gsap.set(compact, {
					...compactPosition,
					scale: state === 'hero' ? 1 : 0.88,
					autoAlpha: state === 'footer' ? 0 : 1,
					force3D: true,
				});
				gsap.set(footerList, {
					...footerPosition,
					scale: 1,
					autoAlpha: state === 'footer' ? 1 : 0,
					force3D: true,
				});
				finishTransition(state);
				return;
			}

			nav.dataset.navTransitioning = '';
			setInteractiveState();
			gsap.set([compact, footerList], {
				willChange: 'transform, opacity',
			});

			if (state === 'footer') {
				gsap.set(footerList, { ...footerPosition, scale: 1, force3D: true });
				transition = gsap
					.timeline({ onComplete: () => finishTransition(state) })
					.to(compact, { autoAlpha: 0, duration: 0.12, ease: 'power1.out' }, 0)
					.to(
						footerList,
						{ autoAlpha: 1, duration: 0.16, ease: 'power1.inOut' },
						0,
					);
				return;
			}

			if (previousState === 'footer') {
				gsap.set(compact, {
					...compactPosition,
					scale: state === 'hero' ? 1 : 0.88,
					force3D: true,
				});
				transition = gsap
					.timeline({ onComplete: () => finishTransition(state) })
					.to(
						footerList,
						{
							autoAlpha: 0,
							duration: 0.12,
							ease: 'power1.out',
						},
						0,
					)
					.to(
						compact,
						{ autoAlpha: 1, duration: 0.16, ease: 'power1.inOut' },
						0,
					);
				return;
			}

			transition = gsap
				.timeline({ onComplete: () => finishTransition(state) })
				.to(compact, { autoAlpha: 0, duration: 0.08, ease: 'power1.out' })
				.set(compact, {
					...compactPosition,
					scale: state === 'hero' ? 1 : 0.88,
					force3D: true,
				})
				.to(compact, { autoAlpha: 1, duration: 0.12, ease: 'power1.in' });
		};

		const getState = (): NavigationState => {
			const viewportHeight =
				window.visualViewport?.height ?? window.innerHeight;
			const footerBounds = footer.getBoundingClientRect();
			if (footerBounds.top < viewportHeight && footerBounds.bottom > 0)
				return 'footer';
			const heroBounds = hero.getBoundingClientRect();
			return heroBounds.top < -1 ? 'content' : 'hero';
		};

		const updateState = (immediate = false) => {
			stateFrame = 0;
			applyState(getState(), immediate);
		};

		const requestStateUpdate = () => {
			if (!stateFrame) {
				stateFrame = window.requestAnimationFrame(() => updateState());
			}
		};

		const measure = () => {
			const visualViewport = window.visualViewport;
			const viewportWidth = visualViewport?.width ?? window.innerWidth;
			const viewportHeight = visualViewport?.height ?? window.innerHeight;
			const viewportLeft = visualViewport?.offsetLeft ?? 0;
			const viewportTop = visualViewport?.offsetTop ?? 0;
			const styles = window.getComputedStyle(nav);
			const safeStart =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-inline-start'),
				) || 0;
			const safeEnd =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-inline-end'),
				) || 0;
			const safeBottom =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-block-end'),
				) || 0;
			const safeTop =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-block-start'),
				) || 0;
			const mobile = window.matchMedia('(max-width: 40rem)').matches;
			const topOffset = mobile ? 11 : 16;
			const inlinePadding = 12;
			const compactWidth = compact.offsetWidth;
			const compactHeight = compact.offsetHeight;
			const footerWidth = footerList.offsetWidth;
			const footerHeight = footerList.offsetHeight;
			const centeredCompactX =
				viewportLeft + (viewportWidth - compactWidth) / 2;
			const heroX = mobile
				? Math.min(
						Math.max(
							centeredCompactX,
							viewportLeft + safeStart + inlinePadding,
						),
						viewportLeft +
							viewportWidth -
							safeEnd -
							compactWidth -
							inlinePadding,
					)
				: Math.max(
						viewportLeft + inlinePadding,
						viewportLeft + viewportWidth - compactWidth - 24,
					);
			const heroY = Math.max(
				viewportTop + topOffset,
				viewportTop + viewportHeight - compactHeight - safeBottom - 42,
			);
			const headerX = Math.max(viewportLeft, centeredCompactX);
			const headerY = viewportTop + safeTop + topOffset;
			const footerX = Math.max(
				viewportLeft,
				viewportLeft + (viewportWidth - footerWidth) / 2,
			);
			const footerY = Math.max(
				viewportTop + topOffset,
				viewportTop + viewportHeight - footerHeight - safeBottom - 12,
			);
			heroPosition = { x: heroX, y: heroY };
			contentPosition = { x: headerX, y: headerY };
			footerPosition = { x: footerX, y: footerY };

			hero.style.setProperty(
				'--hero-contact-nav-clearance',
				`${Math.max(0, viewportTop + viewportHeight - heroY)}px`,
			);
			nav.setAttribute('data-nav-ready', '');
			applyState(getState(), true);
		};

		const handleResize = () => {
			window.cancelAnimationFrame(resizeFrame);
			resizeFrame = window.requestAnimationFrame(() => {
				resizeFrame = window.requestAnimationFrame(measure);
			});
		};
		const handleIntroComplete = () => {
			nav.setAttribute('data-nav-settling', '');
			window.cancelAnimationFrame(settleFrame);
			settleFrame = window.requestAnimationFrame(() => {
				settleFrame = window.requestAnimationFrame(() => {
					measure();
					nav.removeAttribute('data-nav-settling');
				});
			});
		};
		const handleMotionChange = () => applyState(getState(), true);
		const viewportObserver = new ResizeObserver(handleResize);

		const cleanup = () => {
			window.removeEventListener('scroll', requestStateUpdate);
			window.removeEventListener('resize', handleResize);
			window.visualViewport?.removeEventListener('resize', handleResize);
			window.visualViewport?.removeEventListener('scroll', requestStateUpdate);
			window.removeEventListener(FREEFALL_COMPLETE_EVENT, handleIntroComplete);
			viewportObserver.disconnect();
			reducedMotion.removeEventListener('change', handleMotionChange);
			document.removeEventListener('astro:before-swap', cleanup);
			window.cancelAnimationFrame(stateFrame);
			window.cancelAnimationFrame(resizeFrame);
			window.cancelAnimationFrame(settleFrame);
			transition?.kill();
			gsap.set([compact, footerList], {
				clearProps: 'transform,opacity,visibility,will-change',
			});
			delete nav.dataset.navReady;
			delete nav.dataset.navState;
			delete nav.dataset.navTransitioning;
			delete nav.dataset.footerMode;
			delete nav.dataset.navSettling;
			hero.style.removeProperty('--hero-contact-nav-clearance');
			if (socialWindow.__socialFlightCleanup === cleanup) {
				delete socialWindow.__socialFlightCleanup;
			}
		};

		resizeFrame = window.requestAnimationFrame(measure);
		window.addEventListener('scroll', requestStateUpdate, { passive: true });
		window.addEventListener('resize', handleResize, { passive: true });
		window.visualViewport?.addEventListener('resize', handleResize, {
			passive: true,
		});
		window.visualViewport?.addEventListener('scroll', requestStateUpdate, {
			passive: true,
		});
		window.addEventListener(FREEFALL_COMPLETE_EVENT, handleIntroComplete, {
			once: true,
		});
		viewportObserver.observe(document.documentElement);
		reducedMotion.addEventListener('change', handleMotionChange);
		document.addEventListener('astro:before-swap', cleanup, { once: true });
		socialWindow.__socialFlightCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);
	};

	initialiseSocialFlight();
</script>

<style>
	.social-flight {
		--contact-safe-inline-start: env(safe-area-inset-left, 0px);
		--contact-safe-inline-end: env(safe-area-inset-right, 0px);
		--contact-safe-block-start: env(safe-area-inset-top, 0px);
		--contact-safe-block-end: env(safe-area-inset-bottom, 0px);
		position: fixed;
		z-index: 720;
		inset: 0;
		pointer-events: none;
	}

	.contact-list {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.55rem;
		margin: 0;
		background: var(--ink);
		box-shadow: 0.35rem 0.35rem 0 var(--red);
		clip-path: polygon(
			0.65rem 0,
			100% 0,
			100% calc(100% - 0.65rem),
			calc(100% - 0.65rem) 100%,
			0 100%,
			0 0.65rem
		);
		list-style: none;
		pointer-events: none;
		will-change: auto;
	}

	.social-flight[data-nav-transitioning] .contact-list {
		will-change: transform, opacity;
	}

	.social-flight[data-nav-settling] {
		visibility: hidden;
	}

	.social-flight:not([data-nav-ready]) .contact-list--compact {
		inset-block-end: calc(2.625rem + env(safe-area-inset-bottom, 0px));
		inset-inline-start: 50%;
		transform: translateX(-50%);
	}

	.social-flight[data-nav-ready] .contact-list {
		inset-block-start: 0;
		inset-inline-start: 0;
	}

	.contact-list--footer {
		inline-size: min(calc(100vw - 1.5rem), 51.25rem);
		flex-wrap: wrap;
		visibility: hidden;
		opacity: 0;
	}

	.contact-list--compact,
	.contact-list--footer[data-contact-active] {
		pointer-events: auto;
	}

	.contact-item {
		display: flex;
		min-inline-size: 2.75rem;
		min-block-size: 2.75rem;
		align-items: center;
		justify-content: center;
		padding: 0.55rem;
		border: 2px solid rgb(244 228 190 / 34%);
		background: var(--cobalt);
		color: var(--cream-light);
		text-decoration: none;
		pointer-events: auto;
		transition:
			background-color 140ms ease,
			color 140ms ease,
			transform 140ms ease;
	}

	a.contact-item:hover,
	a.contact-item:focus-visible {
		background: var(--red);
		color: var(--cream-light);
		transform: translateY(-2px);
	}

	a.contact-item:focus-visible {
		outline: 0.2rem solid var(--yellow);
		outline-offset: 0.16rem;
	}

	a.contact-item:active {
		transform: translateY(1px);
	}

	.contact-icon {
		flex: none;
		inline-size: 1.35rem;
		block-size: 1.35rem;
	}

	.contact-icon svg {
		inline-size: 100%;
		block-size: 100%;
		fill: currentColor;
	}

	.contact-label {
		margin-inline-start: 0.5rem;
		font-size: 0.8rem;
		font-weight: 900;
		letter-spacing: 0.065em;
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	@media (min-width: 40.001rem) {
		.social-flight:not([data-nav-ready]) .contact-list--compact {
			inset-inline: auto 1.5rem;
			transform: none;
		}
	}

	@media (max-width: 40rem) {
		.contact-list {
			gap: 0.25rem;
			padding: 0.4rem;
			box-shadow: 0.25rem 0.25rem 0 var(--red);
		}

		.contact-item {
			min-inline-size: 2.75rem;
			min-block-size: 2.75rem;
			padding: 0.5rem;
		}

		.contact-label {
			font-size: 0.72rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-list,
		.contact-item {
			will-change: auto;
			transition: none;
		}
	}
</style>
