---
interface Contact {
	label: string;
	icon: 'email' | 'github' | 'linkedin' | 'telegram' | 'whatsapp';
	href: string;
}

const contacts: Contact[] = [
	{
		label: 'Email',
		icon: 'email',
		href: 'mailto:ryan.james.wynn@gmail.com',
	},
	{ label: 'GitHub', icon: 'github', href: 'https://github.com/Ryan-W-Dev' },
	{
		label: 'LinkedIn',
		icon: 'linkedin',
		href: 'https://www.linkedin.com/in/ryan-wynn-01a784403/',
	},
	{ label: 'Telegram', icon: 'telegram', href: 'https://t.me/ryanwynn4' },
	{
		label: 'WhatsApp',
		icon: 'whatsapp',
		href: 'https://wa.me/971508114541',
	},
];

const iconPaths: Record<Contact['icon'], string> = {
	email:
		'M3 5h18v14H3V5Zm2.2 2 6.8 5.1L18.8 7H5.2Zm13.8 2.5-7 5.2-7-5.2V17h14V9.5Z',
	github:
