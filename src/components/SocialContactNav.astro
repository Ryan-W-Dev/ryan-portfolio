	linkedin:
		'M5.2 8.3H1.8V19h3.4V8.3Zm.2-3.4A2 2 0 1 0 1.5 5a2 2 0 0 0 3.9 0ZM22 12.9c0-3.2-1.7-4.9-4-4.9-1.9 0-2.7 1-3.1 1.8V8.3h-3.4V19h3.4v-5.3c0-1.4.3-2.8 2.1-2.8 1.8 0 1.8 1.7 1.8 2.9V19H22v-6.1Z',
	telegram:
		'm21.5 3.7-3 16c-.2 1.1-.9 1.4-1.8.9l-4.6-3.4-2.2 2.2c-.2.2-.5.5-1 .5l.3-4.7 8.6-7.8c.4-.3-.1-.5-.6-.2L6.6 13.9 2 12.4c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.3 1.7Z',
	whatsapp:
		'M12 2.4a9.5 9.5 0 0 0-8.1 14.4l-1.3 4.8 4.9-1.3A9.6 9.6 0 1 0 12 2.4Zm0 17.5c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.9 7.9 0 1 1 12 19.9Zm4.4-5.9c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.8-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4-.2.2-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.2.2-.6.2-1.1.2-1.2-.2-.2-.4-.3-.6-.4Z',
};
---

<nav class="social-flight" data-social-flight aria-label="Contact Ryan Wynn">
	<ul class="contact-list contact-list--compact" data-contact-compact>
		{
			contacts.map((contact) => (
				<li>
					<a
						class="contact-item"
						href={contact.href}
						target={contact.href.startsWith('mailto:') ? undefined : '_blank'}
						rel={
							contact.href.startsWith('mailto:')
								? undefined
								: 'noopener noreferrer'
						}
						aria-label={
							contact.href.startsWith('mailto:')
								? 'Email Ryan Wynn'
								: `${contact.label} — opens in a new tab`
						}
					>
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={iconPaths[contact.icon]} />
							</svg>
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<ul
		class="contact-list contact-list--footer"
		data-contact-footer-list
		aria-hidden="true"
		inert
	>
		{
			contacts.map((contact) => (
				<li>
					<a
						class="contact-item"
						href={contact.href}
						target={contact.href.startsWith('mailto:') ? undefined : '_blank'}
						rel={
							contact.href.startsWith('mailto:')
								? undefined
								: 'noopener noreferrer'
						}
						aria-label={
							contact.href.startsWith('mailto:')
								? 'Email Ryan Wynn'
								: `${contact.label} — opens in a new tab`
						}
					>
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={iconPaths[contact.icon]} />
							</svg>
						</span>
						<span class="contact-label">{contact.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);
	const NAV_TRIGGER_ID = 'social-flight-controller';
	const socialWindow = window as Window & {
		__socialFlightCleanup?: () => void;
	};
	socialWindow.__socialFlightCleanup?.();

	const initialiseSocialFlight = () => {
		const nav = document.querySelector<HTMLElement>('[data-social-flight]');
		const compact = nav?.querySelector<HTMLElement>('[data-contact-compact]');
		const footerList = nav?.querySelector<HTMLElement>(
			'[data-contact-footer-list]',
		);
		const hero = document.querySelector<HTMLElement>('[data-arrival-scene]');
		const footer = document.querySelector<HTMLElement>('[data-contact-footer]');
		if (!nav || !compact || !footerList || !hero || !footer) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let context: gsap.Context | undefined;
		let timeline: gsap.core.Timeline | undefined;
		let trigger: ScrollTrigger | undefined;
		let resizeTimer = 0;
		let buildFrame = 0;
		let navFrame = 0;
		let lastFrameTime = 0;
		let targetProgress = 0;
		let renderedProgress = 0;
		let pendingBuild = false;
		let gestureActive = false;
		let footerInteractive = false;
		let viewport = {
			width: window.innerWidth,
			height: window.innerHeight,
			portrait: window.innerHeight > window.innerWidth,
			breakpoint: window.innerWidth <= 640 ? 'mobile' : 'large',
		};

		const setFooterInteractive = (active: boolean) => {
			if (active === footerInteractive) return;
			footerInteractive = active;
			compact.toggleAttribute('inert', active);
			compact.setAttribute('aria-hidden', String(active));
			footerList.toggleAttribute('inert', !active);
			footerList.setAttribute('aria-hidden', String(!active));
			footerList.toggleAttribute('data-contact-active', active);
			nav.toggleAttribute('data-footer-mode', active);
		};

		const revertTimeline = () => {
			trigger?.kill();
			trigger = undefined;
			timeline?.kill();
			context?.revert();
			timeline = undefined;
			context = undefined;
			window.cancelAnimationFrame(navFrame);
			navFrame = 0;
			lastFrameTime = 0;
		};

		const renderNavigation = (timestamp: number) => {
			navFrame = 0;
			if (!timeline) return;
			const elapsed = lastFrameTime
				? Math.min(48, timestamp - lastFrameTime)
				: 16;
			lastFrameTime = timestamp;
			const difference = targetProgress - renderedProgress;
			const factor = 1 - Math.exp(-elapsed / 72);
			renderedProgress += difference * factor;
			if (Math.abs(difference) < 0.00015) renderedProgress = targetProgress;
			timeline.progress(renderedProgress, false);
			if (renderedProgress !== targetProgress) {
				navFrame = window.requestAnimationFrame(renderNavigation);
			} else {
				lastFrameTime = 0;
			}
		};

		const setNavigationProgress = (progress: number, immediate = false) => {
			targetProgress = Math.max(0, Math.min(1, progress));
			const atBoundary = targetProgress <= 0.0001 || targetProgress >= 0.9999;
			if (immediate || atBoundary || reducedMotion.matches) {
				renderedProgress = targetProgress;
				timeline?.progress(renderedProgress, false);
				window.cancelAnimationFrame(navFrame);
				navFrame = 0;
				lastFrameTime = 0;
				return;
			}
			if (!navFrame) navFrame = window.requestAnimationFrame(renderNavigation);
		};

		const build = () => {
			revertTimeline();
			const visualViewport = window.visualViewport;
			const viewportWidth = visualViewport?.width ?? window.innerWidth;
			const viewportHeight = visualViewport?.height ?? window.innerHeight;
			const styles = window.getComputedStyle(nav);
			const safeStart =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-inline-start'),
				) || 0;
			const safeEnd =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-inline-end'),
				) || 0;
			const safeBottom =
				Number.parseFloat(
					styles.getPropertyValue('--contact-safe-block-end'),
				) || 0;
			const mobile = window.matchMedia('(max-width: 40rem)').matches;
			const topOffset = mobile ? 11 : 16;
			const inlinePadding = 12;
			const compactWidth = compact.offsetWidth;
			const compactHeight = compact.offsetHeight;
			const footerWidth = footerList.offsetWidth;
			const footerHeight = footerList.offsetHeight;
			const centeredCompactX = (viewportWidth - compactWidth) / 2;
			const heroX = mobile
				? Math.min(
						Math.max(centeredCompactX, safeStart + inlinePadding),
						viewportWidth - safeEnd - compactWidth - inlinePadding,
					)
				: Math.max(inlinePadding, viewportWidth - compactWidth - 24);
			const heroY = Math.max(
				topOffset,
				viewportHeight - compactHeight - safeBottom - 42,
			);
			const headerX = Math.max(0, centeredCompactX);
			const headerY = topOffset;
			const footerX = Math.max(0, (viewportWidth - footerWidth) / 2);
			const footerY = Math.max(
				topOffset,
				viewportHeight - footerHeight - safeBottom - 12,
			);
			const maxScroll = Math.max(1, ScrollTrigger.maxScroll(window));
			const heroEnd = Math.min(
				maxScroll,
				Math.max(
					1,
					hero.getBoundingClientRect().top + window.scrollY + hero.offsetHeight,
				),
			);
			const heroTravelEnd = Math.min(
				maxScroll,
				mobile ? heroEnd + viewportHeight * 0.75 : heroEnd,
			);
			const footerTop = footer.getBoundingClientRect().top + window.scrollY;
			const footerStart = Math.min(
				maxScroll - 1,
				Math.max(heroTravelEnd + 1, footerTop - viewportHeight * 0.58),
			);
			const footerDuration = Math.max(1, maxScroll - footerStart);
			const holdDuration = Math.max(0, footerStart - heroTravelEnd);

			hero.style.setProperty(
				'--hero-contact-nav-clearance',
				`${Math.max(0, viewportHeight - heroY)}px`,
			);
			nav.setAttribute('data-nav-ready', '');

			context = gsap.context(() => {
				gsap.set(compact, {
					x: heroX,
					y: heroY,
					scale: 1,
					autoAlpha: 1,
					force3D: true,
				});
				gsap.set(footerList, {
					x: footerX,
					y: headerY,
					scale: 0.9,
					autoAlpha: 0,
					force3D: true,
				});

				if (reducedMotion.matches) {
					gsap.set(compact, {
						x: headerX,
						y: headerY,
						scale: 0.88,
						autoAlpha: 1,
						force3D: true,
					});
					gsap.set(footerList, {
						x: footerX,
						y: footerY,
						scale: 1,
						autoAlpha: 0,
						force3D: true,
					});
					timeline = gsap
						.timeline({ paused: true, defaults: { ease: 'none' } })
						.to(compact, { autoAlpha: 0, duration: 1 }, 0)
						.to(footerList, { autoAlpha: 1, duration: 1 }, 0);
					trigger = ScrollTrigger.create({
						id: NAV_TRIGGER_ID,
						trigger: footer,
						start: 'top 78%',
						end: 'top 42%',
						onUpdate: (self) => {
							setNavigationProgress(self.progress, true);
							setFooterInteractive(self.progress >= 0.5);
						},
						onRefresh: (self) => {
							setNavigationProgress(self.progress, true);
							setFooterInteractive(self.progress >= 0.5);
						},
					});
					return;
				}

				timeline = gsap
					.timeline({ paused: true, defaults: { ease: 'none' } })
					.to(compact, {
						x: headerX,
						y: headerY,
						scale: 0.88,
						duration: heroTravelEnd,
					})
					.to({}, { duration: holdDuration })
					.to(
						compact,
						{
							x: footerX + (footerWidth - compactWidth) / 2,
							y: footerY,
							scale: 0.92,
							autoAlpha: 0,
							duration: footerDuration,
						},
						footerStart,
					)
					.to(
						footerList,
						{
							x: footerX,
							y: footerY,
							scale: 1,
							autoAlpha: 1,
							duration: footerDuration,
						},
						footerStart,
					);

				trigger = ScrollTrigger.create({
					id: NAV_TRIGGER_ID,
					trigger: document.documentElement,
					start: 0,
					end: maxScroll,
					onUpdate: (self) => {
						setNavigationProgress(self.progress);
						setFooterInteractive(
							self.scroll() >= footerStart + footerDuration * 0.5,
						);
					},
					onRefresh: (self) => {
						setNavigationProgress(self.progress, true);
						setFooterInteractive(
							self.scroll() >= footerStart + footerDuration * 0.5,
						);
					},
				});
			}, nav);

			ScrollTrigger.refresh();
		};

		const rebuildWhenIdle = () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = 0;
			if (!pendingBuild || gestureActive || ScrollTrigger.isScrolling()) return;
			pendingBuild = false;
			build();
		};

		const scheduleBuild = () => {
			pendingBuild = true;
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(rebuildWhenIdle, 220);
		};

		const handleResize = () => {
			const next = {
				width: window.innerWidth,
				height: window.innerHeight,
				portrait: window.innerHeight > window.innerWidth,
				breakpoint: window.innerWidth <= 640 ? 'mobile' : 'large',
			};
			const meaningful =
				Math.abs(next.width - viewport.width) >= 1 ||
				next.portrait !== viewport.portrait ||
				next.breakpoint !== viewport.breakpoint ||
				(next.width > 768 && Math.abs(next.height - viewport.height) >= 1);
			viewport = next;
			if (meaningful) scheduleBuild();
		};

		const handlePointerDown = (event: PointerEvent) => {
			if (event.pointerType === 'touch') gestureActive = true;
		};
		const handlePointerUp = (event: PointerEvent) => {
			if (event.pointerType !== 'touch') return;
			gestureActive = false;
			if (pendingBuild) scheduleBuild();
		};
		const handleScrollEnd = () => {
			if (pendingBuild && !gestureActive) scheduleBuild();
		};
		const handleMotionChange = () => scheduleBuild();

		const cleanup = () => {
			window.removeEventListener('resize', handleResize);
			window.removeEventListener('pointerdown', handlePointerDown);
			window.removeEventListener('pointerup', handlePointerUp);
			window.removeEventListener('pointercancel', handlePointerUp);
			window.visualViewport?.removeEventListener('resize', handleResize);
			reducedMotion.removeEventListener('change', handleMotionChange);
			ScrollTrigger.removeEventListener('scrollEnd', handleScrollEnd);
			document.removeEventListener('astro:before-swap', cleanup);
			window.clearTimeout(resizeTimer);
			window.cancelAnimationFrame(buildFrame);
			revertTimeline();
			hero.style.removeProperty('--hero-contact-nav-clearance');
			if (socialWindow.__socialFlightCleanup === cleanup) {
				delete socialWindow.__socialFlightCleanup;
			}
		};

		buildFrame = window.requestAnimationFrame(build);
		window.addEventListener('resize', handleResize, { passive: true });
		window.visualViewport?.addEventListener('resize', handleResize, {
			passive: true,
		});
		reducedMotion.addEventListener('change', handleMotionChange);
		window.addEventListener('pointerdown', handlePointerDown, {
			passive: true,
		});
		window.addEventListener('pointerup', handlePointerUp, { passive: true });
		window.addEventListener('pointercancel', handlePointerUp, {
			passive: true,
		});
		ScrollTrigger.addEventListener('scrollEnd', handleScrollEnd);
		document.addEventListener('astro:before-swap', cleanup, { once: true });
		socialWindow.__socialFlightCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);
	};

	initialiseSocialFlight();
</script>

<style>
	.social-flight {
		--contact-safe-inline-start: env(safe-area-inset-left, 0px);
		--contact-safe-inline-end: env(safe-area-inset-right, 0px);
		--contact-safe-block-end: env(safe-area-inset-bottom, 0px);
		position: fixed;
		z-index: 700;
		inset: 0;
		pointer-events: none;
	}

	.contact-list {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.55rem;
		margin: 0;
		background: var(--ink);
		box-shadow: 0.35rem 0.35rem 0 var(--red);
		clip-path: polygon(
			0.65rem 0,
			100% 0,
			100% calc(100% - 0.65rem),
			calc(100% - 0.65rem) 100%,
			0 100%,
			0 0.65rem
		);
		list-style: none;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.social-flight:not([data-nav-ready]) .contact-list--compact {
		inset-block-end: calc(2.625rem + env(safe-area-inset-bottom, 0px));
		inset-inline-start: 50%;
		transform: translateX(-50%);
	}

	.social-flight[data-nav-ready] .contact-list {
		inset-block-start: 0;
		inset-inline-start: 0;
	}

	.contact-list--footer {
		inline-size: min(calc(100vw - 1.5rem), 51.25rem);
		flex-wrap: wrap;
		visibility: hidden;
		opacity: 0;
	}

	.contact-list--compact,
	.contact-list--footer[data-contact-active] {
		pointer-events: auto;
	}

	.contact-item {
		display: flex;
		min-inline-size: 2.75rem;
		min-block-size: 2.75rem;
		align-items: center;
		justify-content: center;
		padding: 0.55rem;
		border: 2px solid rgb(244 228 190 / 34%);
		background: var(--cobalt);
		color: var(--cream-light);
		text-decoration: none;
		pointer-events: auto;
		transition:
			background-color 140ms ease,
			color 140ms ease,
			transform 140ms ease;
	}

	a.contact-item:hover,
	a.contact-item:focus-visible {
		background: var(--red);
		color: var(--cream-light);
		transform: translateY(-2px);
	}

	a.contact-item:focus-visible {
		outline: 0.2rem solid var(--yellow);
		outline-offset: 0.16rem;
	}

	a.contact-item:active {
		transform: translateY(1px);
	}

	.contact-icon {
		flex: none;
		inline-size: 1.35rem;
		block-size: 1.35rem;
	}

	.contact-icon svg {
		inline-size: 100%;
		block-size: 100%;
		fill: currentColor;
	}

	.contact-label {
		margin-inline-start: 0.5rem;
		font-size: 0.8rem;
		font-weight: 900;
		letter-spacing: 0.065em;
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	@media (min-width: 40.001rem) {
		.social-flight:not([data-nav-ready]) .contact-list--compact {
			inset-inline: auto 1.5rem;
			transform: none;
		}
	}

	@media (max-width: 40rem) {
		.contact-list {
			gap: 0.25rem;
			padding: 0.4rem;
			box-shadow: 0.25rem 0.25rem 0 var(--red);
		}

		.contact-item {
			min-inline-size: 2.75rem;
			min-block-size: 2.75rem;
			padding: 0.5rem;
		}

		.contact-label {
			font-size: 0.72rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-list,
		.contact-item {
			will-change: auto;
			transition: none;
		}
	}
</style>
