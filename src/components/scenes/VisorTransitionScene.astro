---
import CardTrackScene from './CardTrackScene.astro';
import RockFaceScene from './RockFaceScene.astro';
---

<div class="visor-sequence" data-visor-sequence>
	<div class="visor-stage" data-visor-stage>
		<CardTrackScene />

		<div class="visor-window" data-visor-window>
			<div class="visor-reveal-surface" data-visor-reveal-surface>
				<RockFaceScene />
			</div>
		</div>

		<div class="goggle-transition" data-goggle-transition aria-hidden="true">
			<svg
				class="goggle-frame"
				data-goggle-frame
				viewBox="0 0 1200 520"
				preserveAspectRatio="none"
			>
				<path
					class="goggle-frame-body"
					fill-rule="evenodd"
					d="M 132 72 C 270 24 930 24 1068 72 C 1132 94 1170 148 1162 226 C 1154 318 1088 390 1000 424 C 864 476 706 432 600 404 C 494 432 336 476 200 424 C 112 390 46 318 38 226 C 30 148 68 94 132 72 Z M 188 126 C 322 88 878 88 1012 126 C 1072 144 1104 184 1096 238 C 1086 306 1028 350 940 374 C 816 408 682 362 600 336 C 518 362 384 408 260 374 C 172 350 114 306 104 238 C 96 184 128 144 188 126 Z"
				></path>
				<path
					class="goggle-inner-edge"
					d="M 188 126 C 322 88 878 88 1012 126 C 1072 144 1104 184 1096 238 C 1086 306 1028 350 940 374 C 816 408 682 362 600 336 C 518 362 384 408 260 374 C 172 350 114 306 104 238 C 96 184 128 144 188 126 Z"
				></path>
				<path
					class="goggle-reflection goggle-reflection-primary"
					data-goggle-reflection-primary
					pathLength="100"
					d="M 238 168 C 430 112 744 108 954 154"></path>
				<path
					class="goggle-reflection goggle-reflection-secondary"
					data-goggle-reflection-secondary
					pathLength="100"
					d="M 286 216 C 430 178 628 170 786 190"></path>
			</svg>
		</div>
	</div>
</div>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const VISOR_SEQUENCE_TRIGGER_ID = 'extreme-card-visor-sequence';
	const FREEFALL_COMPLETE_EVENT = 'freefall:intro-complete';
	const FINAL_CARD_SETTLE_VIEWPORT_RATIO = 0.25;
	const TRANSITION_SCROLL_RATIOS = {
		helmetForm: 0.55,
		visorLock: 0.45,
		visorPassThrough: 0.9,
		rockFaceResolve: 0.35,
	} as const;
	const GOGGLE_OPENING_RATIOS = {
		inline: 0.82,
		block: 0.54,
	} as const;
	const CARD_COPY_EXIT_DURATION_RATIO = 0.58;
	const ABOUT_PANEL_TIMING = {
		delay: 0.5,
		duration: 0.18,
	} as const;
	const ABOUT_COPY_TIMING = {
		delay: 0.42,
		duration: 0.34,
	} as const;

	const FINAL_CARD_SETTLED_LABEL = 'final-card-settled';
	const VISOR_HANDOFF_LABEL = 'visor-handoff';
	const HELMET_FORM_LABEL = 'helmet-form';
	const VISOR_LOCK_LABEL = 'visor-lock';
	const VISOR_PASS_THROUGH_LABEL = 'visor-pass-through';
	const ROCK_FACE_RESOLVE_LABEL = 'rock-face-resolve';

	const visorSequenceWindow = window as Window & {
		__visorSequenceCleanup?: () => void;
	};

	visorSequenceWindow.__visorSequenceCleanup?.();

	const initialiseVisorSequence = () => {
		const sequence = document.querySelector<HTMLElement>(
			'[data-visor-sequence]',
		);
		const stage = sequence?.querySelector<HTMLElement>('[data-visor-stage]');
		const cardScene = stage?.querySelector<HTMLElement>('[data-card-scene]');
		const cardViewport = cardScene?.querySelector<HTMLElement>(
			'[data-card-viewport]',
		);
		const track =
			cardScene?.querySelector<HTMLOListElement>('[data-card-track]');
		const finalCard = track?.lastElementChild as HTMLElement | null;
		const cardCopy = track
			? Array.from(track.querySelectorAll<HTMLElement>('article'))
			: [];
		const visorWindow = stage?.querySelector<HTMLElement>(
			'[data-visor-window]',
		);
		const revealSurface = visorWindow?.querySelector<HTMLElement>(
			'[data-visor-reveal-surface]',
		);
		const rockScene =
			revealSurface?.querySelector<HTMLElement>('[data-rock-scene]');
		const aboutStatement = rockScene?.querySelector<HTMLElement>(
			'[data-about-statement]',
		);
		const aboutCopy =
			rockScene?.querySelector<HTMLElement>('[data-about-copy]');
		const goggleTransition = stage?.querySelector<HTMLElement>(
			'[data-goggle-transition]',
		);
		const goggleFrame = goggleTransition?.querySelector<SVGSVGElement>(
			'[data-goggle-frame]',
		);
		const primaryReflection = goggleFrame?.querySelector<SVGPathElement>(
			'[data-goggle-reflection-primary]',
		);
		const secondaryReflection = goggleFrame?.querySelector<SVGPathElement>(
			'[data-goggle-reflection-secondary]',
		);

		if (
			!sequence ||
			!stage ||
			!cardScene ||
			!cardViewport ||
			!track ||
			!finalCard ||
			cardCopy.length === 0 ||
			!visorWindow ||
			!revealSurface ||
			!rockScene ||
			!aboutStatement ||
			!aboutCopy ||
			!goggleTransition ||
			!goggleFrame ||
			!primaryReflection ||
			!secondaryReflection
		) {
			return;
		}

		ScrollTrigger.getById(VISOR_SEQUENCE_TRIGGER_ID)?.kill();

		const horizontalTravel = () =>
			Math.max(0, track.scrollWidth - cardViewport.clientWidth);
		const viewportDistance = (ratio: number) =>
			Math.max(1, stage.clientHeight * ratio);
		const alignedFinalCardX = (travelDistance: number) => {
			const finalCardCenter =
				finalCard.offsetLeft + finalCard.offsetWidth / 2 - travelDistance;
			const viewportCenter = cardViewport.clientWidth / 2;

			return -travelDistance + viewportCenter - finalCardCenter;
		};
		const responsiveGoggleGeometry = () => {
			const isPortrait = stage.clientHeight > stage.clientWidth;
			const lockFrameInline = isPortrait
				? stage.clientWidth * 1.85
				: Math.min(stage.clientWidth * 0.86, stage.clientHeight * 1.38);
			const lockFrameBlock = isPortrait
				? Math.min(stage.clientHeight * 0.34, lockFrameInline / 2.75)
				: lockFrameInline / 2.4;
			const lockWindowInline = lockFrameInline * GOGGLE_OPENING_RATIOS.inline;
			const lockWindowBlock = lockFrameBlock * GOGGLE_OPENING_RATIOS.block;
			const passWindowBlock = stage.clientHeight * (isPortrait ? 1.2 : 1.6);
			const passWindowInline = isPortrait
				? Math.max(stage.clientWidth * 4.4, stage.clientHeight * 1.9)
				: passWindowBlock * 3.6;
			const resolveWindowBlock = stage.clientHeight * (isPortrait ? 1.32 : 1.7);
			const resolveWindowInline = isPortrait
				? Math.max(stage.clientWidth * 4.8, stage.clientHeight * 2.05)
				: resolveWindowBlock * 3.6;

			return {
				lockFrameInline,
				lockFrameBlock,
				lockWindowInline,
				lockWindowBlock,
				passWindowInline,
				passWindowBlock,
				passFrameInline: passWindowInline / GOGGLE_OPENING_RATIOS.inline,
				passFrameBlock: passWindowBlock / GOGGLE_OPENING_RATIOS.block,
				resolveWindowInline,
				resolveWindowBlock,
				resolveFrameInline: resolveWindowInline / GOGGLE_OPENING_RATIOS.inline,
				resolveFrameBlock: resolveWindowBlock / GOGGLE_OPENING_RATIOS.block,
			};
		};

		let context: gsap.Context | undefined;
		let timeline: gsap.core.Timeline | undefined;
		let resizeFrame: number | undefined;
		let disposed = false;

		const revertTimeline = () => {
			timeline?.scrollTrigger?.kill();
			timeline?.kill();
			timeline = undefined;
			context?.revert();
			context = undefined;
		};

		const buildTimeline = () => {
			revertTimeline();

			const travelDistance = horizontalTravel();
			const settleDistance = viewportDistance(FINAL_CARD_SETTLE_VIEWPORT_RATIO);
			const helmetFormDistance = viewportDistance(
				TRANSITION_SCROLL_RATIOS.helmetForm,
			);
			const visorLockDistance = viewportDistance(
				TRANSITION_SCROLL_RATIOS.visorLock,
			);
			const visorPassThroughDistance = viewportDistance(
				TRANSITION_SCROLL_RATIOS.visorPassThrough,
			);
			const rockFaceResolveDistance = viewportDistance(
				TRANSITION_SCROLL_RATIOS.rockFaceResolve,
			);
			const transitionDistance =
				helmetFormDistance +
				visorLockDistance +
				visorPassThroughDistance +
				rockFaceResolveDistance;
			const totalScrollDistance =
				travelDistance + settleDistance + transitionDistance;
			const settleState = { progress: 0 };
			const goggleGeometry = responsiveGoggleGeometry();
			const aboutPanelRevealStart = `${VISOR_PASS_THROUGH_LABEL}+=${visorPassThroughDistance * ABOUT_PANEL_TIMING.delay}`;
			const aboutCopyRevealStart = `${ROCK_FACE_RESOLVE_LABEL}+=${rockFaceResolveDistance * ABOUT_COPY_TIMING.delay}`;

			context = gsap.context(() => {
				gsap.set(track, { x: 0 });
				gsap.set(cardViewport, {
					autoAlpha: 1,
					rotation: 0,
					scale: 1,
					transformOrigin: '50% 50%',
				});
				gsap.set(cardCopy, {
					autoAlpha: 1,
					yPercent: 0,
				});
				gsap.set(finalCard, {
					borderRadius: 0,
					scale: 1,
					transformOrigin: '50% 50%',
				});
				gsap.set(revealSurface, {
					width: stage.clientWidth,
					height: stage.clientHeight,
				});
				gsap.set(visorWindow, {
					width: 4,
					height: 1,
				});
				gsap.set(aboutStatement, {
					autoAlpha: 0,
					yPercent: 4,
				});
				gsap.set(aboutCopy, {
					autoAlpha: 0,
					yPercent: 7,
				});
				gsap.set(goggleFrame, {
					autoAlpha: 0,
					rotation: 0,
					xPercent: -50,
					yPercent: -50,
					width: goggleGeometry.lockFrameInline * 0.72,
					height: goggleGeometry.lockFrameBlock * 0.72,
					transformOrigin: '50% 50%',
				});
				gsap.set([primaryReflection, secondaryReflection], {
					autoAlpha: 0,
					strokeDashoffset: 100,
				});

				timeline = gsap
					.timeline({
						defaults: { ease: 'none' },
						scrollTrigger: {
							id: VISOR_SEQUENCE_TRIGGER_ID,
							trigger: sequence,
							start: 'top top',
							end: `+=${Math.max(totalScrollDistance, 1)}`,
							scrub: true,
							pin: stage,
							refreshPriority: 10,
							invalidateOnRefresh: true,
							onToggle: (self) => {
								gsap.set([track, cardViewport, goggleFrame, visorWindow], {
									willChange: self.isActive ? 'transform, opacity' : 'auto',
								});
							},
						},
					})
					.to(track, {
						x: -travelDistance,
						duration: Math.max(travelDistance, 1),
					})
					.addLabel(FINAL_CARD_SETTLED_LABEL)
					.to(settleState, {
						progress: 1,
						duration: settleDistance,
					})
					.addLabel(VISOR_HANDOFF_LABEL)
					.addLabel(HELMET_FORM_LABEL)
					.to(
						track,
						{
							x: alignedFinalCardX(travelDistance),
							duration: helmetFormDistance,
						},
						HELMET_FORM_LABEL,
					)
					.to(
						cardViewport,
						{
							autoAlpha: 0,
							rotation: -1.2,
							scale: 0.92,
							duration: helmetFormDistance,
						},
						HELMET_FORM_LABEL,
					)
					.to(
						cardCopy,
						{
							autoAlpha: 0,
							yPercent: -10,
							duration: helmetFormDistance * CARD_COPY_EXIT_DURATION_RATIO,
						},
						HELMET_FORM_LABEL,
					)
					.to(
						finalCard,
						{
							borderRadius: '20% 20% 18% 18% / 22% 22% 28% 28%',
							scale: 0.96,
							duration: helmetFormDistance,
						},
						HELMET_FORM_LABEL,
					)
					.to(
						goggleFrame,
						{
							autoAlpha: 1,
							width: goggleGeometry.lockFrameInline,
							height: goggleGeometry.lockFrameBlock,
							duration: helmetFormDistance,
						},
						HELMET_FORM_LABEL,
					)
					.addLabel(VISOR_LOCK_LABEL)
					.to(
						cardViewport,
						{
							autoAlpha: 0,
							rotation: 1.4,
							scale: 0.84,
							duration: visorLockDistance,
						},
						VISOR_LOCK_LABEL,
					)
					.to(
						visorWindow,
						{
							width: goggleGeometry.lockWindowInline,
							height: goggleGeometry.lockWindowBlock,
							duration: visorLockDistance,
						},
						VISOR_LOCK_LABEL,
					)
					.to(
						primaryReflection,
						{
							autoAlpha: 0.62,
							strokeDashoffset: 20,
							duration: visorLockDistance,
						},
						VISOR_LOCK_LABEL,
					)
					.to(
						secondaryReflection,
						{
							autoAlpha: 0.36,
							strokeDashoffset: 35,
							duration: visorLockDistance,
						},
						VISOR_LOCK_LABEL,
					)
					.addLabel(VISOR_PASS_THROUGH_LABEL)
					.to(
						cardViewport,
						{
							autoAlpha: 0,
							rotation: -2.2,
							scale: 0.7,
							duration: visorPassThroughDistance,
						},
						VISOR_PASS_THROUGH_LABEL,
					)
					.to(
						visorWindow,
						{
							width: goggleGeometry.passWindowInline,
							height: goggleGeometry.passWindowBlock,
							duration: visorPassThroughDistance,
						},
						VISOR_PASS_THROUGH_LABEL,
					)
					.to(
						goggleFrame,
						{
							rotation: 1.2,
							width: goggleGeometry.passFrameInline,
							height: goggleGeometry.passFrameBlock,
							duration: visorPassThroughDistance,
						},
						VISOR_PASS_THROUGH_LABEL,
					)
					.to(
						primaryReflection,
						{
							autoAlpha: 0.18,
							strokeDashoffset: -65,
							duration: visorPassThroughDistance,
						},
						VISOR_PASS_THROUGH_LABEL,
					)
					.to(
						secondaryReflection,
						{
							autoAlpha: 0,
							strokeDashoffset: -80,
							duration: visorPassThroughDistance,
						},
						VISOR_PASS_THROUGH_LABEL,
					)
					.to(
						aboutStatement,
						{
							autoAlpha: 1,
							yPercent: 0,
							duration: visorPassThroughDistance * ABOUT_PANEL_TIMING.duration,
						},
						aboutPanelRevealStart,
					)
					.addLabel(ROCK_FACE_RESOLVE_LABEL)
					.to(
						visorWindow,
						{
							width: goggleGeometry.resolveWindowInline,
							height: goggleGeometry.resolveWindowBlock,
							duration: rockFaceResolveDistance,
						},
						ROCK_FACE_RESOLVE_LABEL,
					)
					.to(
						goggleFrame,
						{
							autoAlpha: 0,
							rotation: 0,
							width: goggleGeometry.resolveFrameInline,
							height: goggleGeometry.resolveFrameBlock,
							duration: rockFaceResolveDistance,
						},
						ROCK_FACE_RESOLVE_LABEL,
					)
					.to(
						cardViewport,
						{
							autoAlpha: 0,
							duration: rockFaceResolveDistance * 0.35,
						},
						ROCK_FACE_RESOLVE_LABEL,
					)
					.to(
						aboutCopy,
						{
							autoAlpha: 1,
							yPercent: 0,
							duration: rockFaceResolveDistance * ABOUT_COPY_TIMING.duration,
						},
						aboutCopyRevealStart,
					);
			}, sequence);
		};

		const handleResize = () => {
			if (disposed) {
				return;
			}

			if (resizeFrame !== undefined) {
				window.cancelAnimationFrame(resizeFrame);
			}

			resizeFrame = window.requestAnimationFrame(() => {
				resizeFrame = undefined;
				buildTimeline();
				ScrollTrigger.refresh();
			});
		};

		const handleFreefallComplete = () => {
			handleResize();
		};

		const cleanup = () => {
			if (disposed) {
				return;
			}

			disposed = true;
			window.removeEventListener('resize', handleResize);
			window.removeEventListener(
				FREEFALL_COMPLETE_EVENT,
				handleFreefallComplete,
			);
			document.removeEventListener('astro:before-swap', cleanup);

			if (resizeFrame !== undefined) {
				window.cancelAnimationFrame(resizeFrame);
				resizeFrame = undefined;
			}

			revertTimeline();

			if (visorSequenceWindow.__visorSequenceCleanup === cleanup) {
				delete visorSequenceWindow.__visorSequenceCleanup;
			}
		};

		buildTimeline();
		window.addEventListener('resize', handleResize, { passive: true });
		window.addEventListener(FREEFALL_COMPLETE_EVENT, handleFreefallComplete, {
			once: true,
		});
		document.addEventListener('astro:before-swap', cleanup, { once: true });

		visorSequenceWindow.__visorSequenceCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);

		ScrollTrigger.refresh();
	};

	initialiseVisorSequence();
</script>

<style>
	.visor-sequence {
		position: relative;
		background: var(--cream);
	}

	.visor-stage {
		position: relative;
		isolation: isolate;
		inline-size: 100%;
		block-size: 100vh;
		block-size: 100svh;
		overflow: clip;
		background: var(--cream);
	}

	.visor-stage :global([data-card-scene]) {
		position: absolute;
		z-index: 1;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		min-block-size: 100%;
	}

	.visor-window {
		position: absolute;
		z-index: 2;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		inline-size: 4px;
		block-size: 1px;
		overflow: hidden;
		border-radius: 24% 24% 28% 28% / 38% 38% 46% 46%;
		isolation: isolate;
		border: clamp(0.2rem, 0.45vw, 0.45rem) solid var(--ink);
		background: var(--cobalt);
		box-shadow: 0.6rem 0.7rem 0 var(--red);
		translate: -50% -50%;
	}

	.visor-reveal-surface {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		inline-size: 100vw;
		block-size: 100vh;
		block-size: 100svh;
		translate: -50% -50%;
	}

	.visor-reveal-surface :global([data-rock-scene]) {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		min-block-size: 100%;
	}

	.visor-reveal-surface :global([data-about-statement]) {
		visibility: hidden;
		opacity: 0;
	}

	.goggle-transition {
		position: absolute;
		z-index: 3;
		inset: 0;
		pointer-events: none;
		filter: drop-shadow(
			clamp(0.4rem, 0.9vw, 0.9rem) clamp(0.4rem, 0.9vw, 0.9rem) 0 var(--red)
		);
	}

	.goggle-frame {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		display: block;
		inline-size: 1px;
		block-size: 1px;
		max-inline-size: none;
		overflow: visible;
	}

	.goggle-frame-body {
		fill: var(--ink);
		stroke: var(--cream-light);
		stroke-width: 4;
		paint-order: stroke fill;
	}

	.goggle-inner-edge {
		fill: none;
		stroke: var(--orange);
		stroke-width: 14;
		vector-effect: non-scaling-stroke;
	}

	.goggle-reflection {
		fill: none;
		stroke: rgb(255 242 211 / 82%);
		stroke-linecap: round;
		stroke-width: 4;
		stroke-dasharray: 52 48;
		vector-effect: non-scaling-stroke;
	}

	.goggle-reflection-secondary {
		stroke: var(--yellow);
		stroke-width: 2;
	}
</style>
