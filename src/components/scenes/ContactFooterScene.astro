---
const contacts = [
	{ label: 'Email', href: 'mailto:[PROFESSIONAL_EMAIL]' },
	{ label: 'GitHub', href: 'https://github.com/Ryan-W-Dev' },
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/ryan-wynn-01a784403/',
	},
	{ label: 'Telegram', href: '[TELEGRAM_URL]' },
	{ label: 'WhatsApp Messenger', href: '[WHATSAPP_URL]' },
];
---

<footer class="scene contact-footer">
	<nav aria-label="Contact">
		<ul>
			{
				contacts.map((contact) => (
					<li>
						<a href={contact.href}>{contact.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</footer>

<style>
	.contact-footer {
		align-items: end;
		background: var(--color-surface);
	}

	nav {
		inline-size: 100%;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	a {
		display: inline-block;
		padding-block: 0.5rem;
		font-size: clamp(1rem, 2vw, 1.25rem);
		text-underline-offset: 0.25em;
	}

	@media (max-width: 48rem) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
