---
import DirtBikeArtwork from '../DirtBikeArtwork.astro';
---

<footer class="scene contact-footer" data-contact-footer>
	<picture class="footer-portrait-frame" aria-hidden="true">
		<source
			media="(max-width: 56rem)"
			srcset="/assets/footer/footer-racer-ryan-mobile-v04.webp"
		/>
		<img
			src="/assets/footer/footer-racer-ryan-v04.webp"
			alt=""
			width="1920"
			height="823"
			loading="lazy"
			decoding="async"
			draggable="false"
		/>
	</picture>

	<svg
		class="eye-overlay eye-overlay--desktop"
		viewBox="0 0 1920 823"
		preserveAspectRatio="xMidYMid slice"
		aria-hidden="true"
	>
		<defs>
			<clipPath id="desktop-eye-regions">
				<ellipse cx="592" cy="305" rx="57" ry="39"></ellipse>
				<ellipse cx="717" cy="306" rx="58" ry="39"></ellipse>
			</clipPath>
		</defs>
		<g class="eye-lids" clip-path="url(#desktop-eye-regions)">
			<image
				href="/assets/footer/footer-racer-ryan-v04-closed.webp"
				width="1920"
				height="823"
			/>
		</g>
	</svg>

	<svg
		class="eye-overlay eye-overlay--mobile"
		viewBox="0 0 900 1200"
		preserveAspectRatio="xMidYMid slice"
		aria-hidden="true"
	>
		<defs>
			<clipPath id="mobile-eye-regions">
				<ellipse cx="404" cy="416" rx="61" ry="45"></ellipse>
				<ellipse cx="556" cy="419" rx="63" ry="45"></ellipse>
			</clipPath>
		</defs>
		<g class="eye-lids" clip-path="url(#mobile-eye-regions)">
			<image
				href="/assets/footer/footer-racer-ryan-mobile-v04-closed.webp"
				width="900"
				height="1200"
			/>
		</g>
	</svg>

	<div class="footer-grade" aria-hidden="true"></div>
</footer>

<div class="footer-cursor-bike" data-footer-cursor-bike aria-hidden="true">
	<DirtBikeArtwork />
</div>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const footerWindow = window as Window & {
		__footerMotionCleanup?: () => void;
	};
	footerWindow.__footerMotionCleanup?.();

	const initialiseFooterMotion = () => {
		const footer = document.querySelector<HTMLElement>('[data-contact-footer]');
		const cursorBike = document.querySelector<HTMLElement>(
			'[data-footer-cursor-bike]',
		);
		if (!footer || !cursorBike) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const finePointer = window.matchMedia('(pointer: fine)');
		let context: gsap.Context | undefined;
		let footerVisible = false;
		let cursorReady = false;
		let pointerInside = false;
		let cursorMode = false;
		let frame = 0;
		let nextBlinkTimer = 0;
		let openBlinkTimer = 0;
		let doubleBlinkTimer = 0;
		let viewportWidth = window.innerWidth;
		let viewportHeight = window.innerHeight;
		let viewportPortrait = viewportHeight > viewportWidth;
		let targetClientX = window.innerWidth * 0.5;
		let targetClientY = window.innerHeight * 0.45;
		let hasPointerSample = false;

		const clearBlinkTimers = () => {
			window.clearTimeout(nextBlinkTimer);
			window.clearTimeout(openBlinkTimer);
			window.clearTimeout(doubleBlinkTimer);
			nextBlinkTimer = 0;
			openBlinkTimer = 0;
			doubleBlinkTimer = 0;
			footer.classList.remove('is-blinking');
		};

		const canBlink = () =>
			footerVisible && !document.hidden && !reducedMotion.matches;

		const closeEyes = () => {
			if (!canBlink()) return;
			footer.classList.add('is-blinking');
			openBlinkTimer = window.setTimeout(
				() => footer.classList.remove('is-blinking'),
				110,
			);
		};

		const scheduleBlink = () => {
			clearBlinkTimers();
			if (!canBlink()) return;
			const delay = 2800 + Math.random() * 3600;
			nextBlinkTimer = window.setTimeout(() => {
				closeEyes();
				if (Math.random() > 0.78) {
					doubleBlinkTimer = window.setTimeout(closeEyes, 235);
				}
				nextBlinkTimer = window.setTimeout(scheduleBlink, 520);
			}, delay);
		};

		const restoreCursor = () => {
			cursorMode = false;
			delete document.documentElement.dataset.footerCursorBikeActive;
			gsap.set(cursorBike, { autoAlpha: 0 });
		};

		const stopFrame = () => {
			window.cancelAnimationFrame(frame);
			frame = 0;
		};

		const activateCursorBike = () => {
			if (
				cursorMode ||
				!cursorReady ||
				!pointerInside ||
				reducedMotion.matches ||
				!finePointer.matches
			)
				return;
			cursorMode = true;
			document.documentElement.dataset.footerCursorBikeActive = '';
			gsap.set(cursorBike, {
				autoAlpha: 1,
				x: targetClientX,
				y: targetClientY,
			});
		};

		const renderTracking = () => {
			frame = 0;
			if (
				!cursorReady ||
				!pointerInside ||
				document.hidden ||
				reducedMotion.matches ||
				!finePointer.matches
			)
				return;

			activateCursorBike();
			gsap.set(cursorBike, {
				x: targetClientX,
				y: targetClientY,
				force3D: true,
			});
			frame = window.requestAnimationFrame(renderTracking);
		};

		const startFrame = () => {
			if (!frame) frame = window.requestAnimationFrame(renderTracking);
		};

		const setCursorReady = (ready: boolean) => {
			cursorReady = ready && finePointer.matches && !reducedMotion.matches;
			if (cursorReady && hasPointerSample) {
				const rect = footer.getBoundingClientRect();
				pointerInside =
					targetClientX >= rect.left &&
					targetClientX <= rect.right &&
					targetClientY >= rect.top &&
					targetClientY <= rect.bottom;
			}
			if (cursorReady && pointerInside) startFrame();
			else {
				stopFrame();
				restoreCursor();
			}
		};

		const handlePointerMove = (event: PointerEvent) => {
			hasPointerSample = true;
			targetClientX = event.clientX;
			targetClientY = event.clientY;
			const rect = footer.getBoundingClientRect();
			const isInside =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;

			if (isInside) {
				pointerInside = true;
				if (cursorReady) startFrame();
			} else if (pointerInside) {
				pointerInside = false;
				stopFrame();
				restoreCursor();
			}
		};

		const handlePointerOut = (event: PointerEvent) => {
			if (event.relatedTarget) return;
			pointerInside = false;
			stopFrame();
			restoreCursor();
		};

		const buildMotion = () => {
			context?.revert();
			restoreCursor();
			if (reducedMotion.matches) {
				setCursorReady(false);
				gsap.set(cursorBike, { autoAlpha: 0, clearProps: 'transform' });
				return;
			}

			context = gsap.context(() => {
				gsap.set(cursorBike, {
					autoAlpha: 0,
					xPercent: -50,
					yPercent: -50,
				});

				ScrollTrigger.create({
					id: 'footer-bike-cursor',
					trigger: footer,
					start: 'top 72%',
					end: 'top top',
					invalidateOnRefresh: true,
					onUpdate: (self) => {
						setCursorReady(self.progress > 0.94);
					},
					onLeaveBack: () => setCursorReady(false),
					onRefresh: (self) => {
						setCursorReady(self.progress > 0.94);
					},
				});
			}, footer);
		};

		const observer = new IntersectionObserver(
			([entry]) => {
				footerVisible = entry.isIntersecting;
				scheduleBlink();
				if (!footerVisible) {
					pointerInside = false;
					setCursorReady(false);
				}
			},
			{ threshold: 0.12 },
		);

		let resizeFrame = 0;
		const queueMotionBuild = () => {
			window.cancelAnimationFrame(resizeFrame);
			resizeFrame = window.requestAnimationFrame(() => {
				restoreCursor();
				buildMotion();
				ScrollTrigger.refresh();
			});
		};
		const handleResize = () => {
			const nextWidth = window.innerWidth;
			const nextHeight = window.innerHeight;
			const nextPortrait = nextHeight > nextWidth;
			const widthChanged = Math.abs(nextWidth - viewportWidth) >= 1;
			const heightChanged = Math.abs(nextHeight - viewportHeight) >= 1;
			const meaningfulResize =
				widthChanged ||
				nextPortrait !== viewportPortrait ||
				(nextWidth > 768 && heightChanged);
			viewportWidth = nextWidth;
			viewportHeight = nextHeight;
			viewportPortrait = nextPortrait;
			if (!meaningfulResize) return;
			queueMotionBuild();
		};
		const handleMediaChange = () => queueMotionBuild();

		const handleVisibility = () => {
			scheduleBlink();
			if (document.hidden) {
				stopFrame();
				restoreCursor();
			} else if (cursorReady && pointerInside) {
				startFrame();
			}
		};

		const cleanup = () => {
			clearBlinkTimers();
			stopFrame();
			restoreCursor();
			observer.disconnect();
			window.removeEventListener('resize', handleResize);
			window.removeEventListener('pointermove', handlePointerMove);
			window.removeEventListener('pointerout', handlePointerOut);
			document.removeEventListener('visibilitychange', handleVisibility);
			reducedMotion.removeEventListener('change', handleMediaChange);
			finePointer.removeEventListener('change', handleMediaChange);
			document.removeEventListener('astro:before-swap', cleanup);
			window.cancelAnimationFrame(resizeFrame);
			context?.revert();
			if (footerWindow.__footerMotionCleanup === cleanup)
				delete footerWindow.__footerMotionCleanup;
		};

		buildMotion();
		observer.observe(footer);
		window.addEventListener('resize', handleResize, { passive: true });
		window.addEventListener('pointermove', handlePointerMove, {
			passive: true,
		});
		window.addEventListener('pointerout', handlePointerOut);
		document.addEventListener('visibilitychange', handleVisibility);
		reducedMotion.addEventListener('change', handleMediaChange);
		finePointer.addEventListener('change', handleMediaChange);
		document.addEventListener('astro:before-swap', cleanup, { once: true });
		footerWindow.__footerMotionCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);
	};

	initialiseFooterMotion();
</script>

<style>
	.contact-footer {
		min-block-size: 100vh;
		min-block-size: 100svh;
		isolation: isolate;
		overflow: hidden;
		padding: 0;
		background: var(--ink);
	}

	.footer-portrait-frame,
	.footer-portrait-frame img,
	.footer-grade,
	.eye-overlay {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
	}

	.footer-portrait-frame {
		z-index: 0;
	}

	.footer-portrait-frame img {
		max-inline-size: none;
		object-fit: cover;
		object-position: center;
		user-select: none;
	}

	.eye-overlay--mobile {
		display: none;
	}

	.footer-grade {
		z-index: 3;
		background:
			linear-gradient(180deg, rgb(6 28 56 / 4%) 42%, rgb(6 28 56 / 92%) 100%),
			linear-gradient(
				90deg,
				transparent 35%,
				rgb(6 28 56 / 16%) 58%,
				rgb(6 28 56 / 62%) 100%
			);
		pointer-events: none;
	}

	.eye-overlay {
		z-index: 4;
		max-inline-size: none;
		overflow: hidden;
		pointer-events: none;
	}

	.eye-lids {
		opacity: 0;
		transition: opacity 90ms ease-out;
	}

	.contact-footer.is-blinking .eye-lids {
		opacity: 1;
		transition-duration: 45ms;
		transition-timing-function: ease-in;
	}

	.footer-cursor-bike {
		position: fixed;
		z-index: 710;
		inset: 0 auto auto 0;
		inline-size: clamp(2.8rem, 4.5vw, 4.4rem);
		opacity: 0;
		pointer-events: none;
		filter: drop-shadow(0.18rem 0.22rem 0 var(--ink));
		will-change: transform;
	}

	:global(html:not([data-footer-cursor-bike-active])) .footer-cursor-bike {
		opacity: 0 !important;
		visibility: hidden !important;
	}

	:global(html[data-footer-cursor-bike-active]),
	:global(html[data-footer-cursor-bike-active] *) {
		cursor: none;
	}

	@media (max-width: 56rem) {
		.eye-overlay--desktop {
			display: none;
		}

		.eye-overlay--mobile {
			display: block;
		}

		.footer-grade {
			background: linear-gradient(
				180deg,
				transparent 38%,
				rgb(6 28 56 / 92%) 100%
			);
		}
	}

	@media (pointer: coarse) {
		.footer-cursor-bike {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.eye-lids,
		.footer-cursor-bike {
			display: none;
		}
	}
</style>
