---
import FreefallIntroMotion from './FreefallIntroMotion.astro';

const terrainPasses = [
	{ family: 'terrain-far', phase: '0' },
	{ family: 'terrain-far', phase: '0.5' },
	{ family: 'terrain-mid', phase: '0.18' },
	{ family: 'terrain-mid', phase: '0.68' },
	{ family: 'terrain-near', phase: '0.34' },
	{ family: 'terrain-near', phase: '0.84' },
] as const;
---

<div
	class="freefall-intro"
	data-freefall-intro
	data-intro-state="pending"
	aria-hidden="true"
>
	<div class="freefall-world" data-freefall-world>
		<div class="terrain-camera" data-terrain-camera>
			{
				terrainPasses.map((pass) => (
					<picture>
						<source
							media="(max-width: 40rem)"
							srcset="/assets/freefall/freefall-environment-mobile.webp"
						/>
						<img
							class={`terrain-pass ${pass.family}`}
							data-depth-family={pass.family}
							data-initial-phase={pass.phase}
							src="/assets/freefall/freefall-environment.webp"
							alt=""
							width="1920"
							height="1080"
							decoding="async"
							draggable="false"
						/>
					</picture>
				))
			}
		</div>

		<div class="fall-clouds" aria-hidden="true">
			<svg
				class="fall-cloud-pass fall-cloud-pass--one"
				data-depth-family="cloud"
				data-initial-phase="0.12"
				viewBox="0 0 500 220"
			>
				<path
					class="fall-cloud-body"
					d="M18 155C59 116 108 118 139 137C164 77 230 55 278 100C319 66 386 78 408 132C445 128 476 145 491 174C391 206 127 210 18 155Z"
				></path>
				<path
					class="fall-cloud-ink"
					d="M48 164C135 190 315 192 451 160M119 137C141 151 166 157 192 156M274 116C306 137 345 143 378 139"
				></path>
			</svg>
			<svg
				class="fall-cloud-pass fall-cloud-pass--two"
				data-depth-family="cloud"
				data-initial-phase="0.37"
				viewBox="0 0 500 220"
			>
				<path
					class="fall-cloud-body"
					d="M18 155C59 116 108 118 139 137C164 77 230 55 278 100C319 66 386 78 408 132C445 128 476 145 491 174C391 206 127 210 18 155Z"
				></path>
				<path
					class="fall-cloud-ink"
					d="M48 164C135 190 315 192 451 160M119 137C141 151 166 157 192 156M274 116C306 137 345 143 378 139"
				></path>
			</svg>
			<svg
				class="fall-cloud-pass fall-cloud-pass--three"
				data-depth-family="cloud"
				data-initial-phase="0.62"
				viewBox="0 0 500 220"
			>
				<path
					class="fall-cloud-body"
					d="M18 155C59 116 108 118 139 137C164 77 230 55 278 100C319 66 386 78 408 132C445 128 476 145 491 174C391 206 127 210 18 155Z"
				></path>
				<path
					class="fall-cloud-ink"
					d="M48 164C135 190 315 192 451 160M119 137C141 151 166 157 192 156M274 116C306 137 345 143 378 139"
				></path>
			</svg>
			<svg
				class="fall-cloud-pass fall-cloud-pass--four"
				data-depth-family="cloud"
				data-initial-phase="0.87"
				viewBox="0 0 500 220"
			>
				<path
					class="fall-cloud-body"
					d="M18 155C59 116 108 118 139 137C164 77 230 55 278 100C319 66 386 78 408 132C445 128 476 145 491 174C391 206 127 210 18 155Z"
				></path>
				<path
					class="fall-cloud-ink"
					d="M48 164C135 190 315 192 451 160M119 137C141 151 166 157 192 156M274 116C306 137 345 143 378 139"
				></path>
			</svg>
		</div>

		<div
			class="speed-burst"
			data-depth-family="speed"
			data-initial-phase="0.22"
		>
			<span></span><span></span><span></span><span></span><span></span><span
			></span>
			<span></span><span></span><span></span><span></span><span></span><span
			></span>
		</div>

		<div class="freefall-vignette" aria-hidden="true"></div>
	</div>
</div>

<FreefallIntroMotion />

<style>
	.freefall-intro {
		position: fixed;
		z-index: 1000;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: 100vw;
		block-size: 100vh;
		block-size: 100svh;
		overflow: hidden;
		background: var(--ink);
		animation: freefall-intro-fallback-complete 0.3s ease-out 4s forwards;
		pointer-events: none;
		touch-action: none;
	}

	.freefall-intro[hidden] {
		display: none;
	}

	.freefall-intro[data-intro-owner='gsap'] {
		animation: none;
	}

	@keyframes freefall-intro-fallback-complete {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}

	.freefall-world,
	.terrain-camera,
	.fall-clouds,
	.speed-burst,
	.freefall-vignette {
		position: absolute;
		inset: 0;
	}

	.freefall-world {
		--hero-reveal: 0%;
		overflow: hidden;
		background: var(--cobalt);
		visibility: visible;
		-webkit-mask-image: radial-gradient(
			circle at 50% 50%,
			transparent 0 var(--hero-reveal),
			#000 calc(var(--hero-reveal) + 0.12%)
		);
		mask-image: radial-gradient(
			circle at 50% 50%,
			transparent 0 var(--hero-reveal),
			#000 calc(var(--hero-reveal) + 0.12%)
		);
	}

	.freefall-intro[data-intro-owner='gsap'] {
		background: transparent;
	}

	.terrain-camera {
		transform: none;
	}

	.freefall-intro:not([data-intro-owner='gsap']) .terrain-pass {
		animation: freefall-css-terrain 0.95s linear infinite;
	}

	.freefall-intro:not([data-intro-owner='gsap']) .terrain-pass:nth-child(even) {
		animation-delay: -0.48s;
	}

	@keyframes freefall-css-terrain {
		0% {
			opacity: 0;
			transform: scale(0.42);
		}
		18%,
		72% {
			opacity: 0.58;
		}
		100% {
			opacity: 0;
			transform: scale(4.6);
		}
	}

	.terrain-pass {
		position: absolute;
		inset: -4%;
		inline-size: 108%;
		block-size: 108%;
		max-inline-size: none;
		object-fit: cover;
		object-position: 50% 50%;
		transform-origin: 50% 50%;
		user-select: none;
	}

	.terrain-far {
		filter: saturate(0.82) contrast(1.05);
	}

	.terrain-mid {
		clip-path: polygon(0 31%, 100% 31%, 100% 100%, 0 100%);
		filter: saturate(1.05) contrast(1.08);
	}

	.terrain-near {
		clip-path: polygon(0 56%, 100% 50%, 100% 100%, 0 100%);
		filter: saturate(1.16) contrast(1.12);
	}

	.fall-clouds {
		filter: drop-shadow(0.45rem 0.55rem 0 rgb(6 28 56 / 34%));
	}

	.fall-cloud-pass {
		--fall-cloud-transform-origin: 50% 50%;
		position: absolute;
		inline-size: 34vmax;
		block-size: 15vmax;
		overflow: visible;
		transform-origin: 50% 50%;
	}

	.freefall-intro:not([data-intro-owner='gsap']) .fall-cloud-pass {
		animation: freefall-css-cloud 0.72s linear infinite;
		transform-origin: var(--fall-cloud-transform-origin);
	}

	.freefall-intro:not([data-intro-owner='gsap']) .fall-cloud-pass--two {
		animation-delay: -0.18s;
	}

	.freefall-intro:not([data-intro-owner='gsap']) .fall-cloud-pass--three {
		animation-delay: -0.36s;
	}

	.freefall-intro:not([data-intro-owner='gsap']) .fall-cloud-pass--four {
		animation-delay: -0.54s;
	}

	@keyframes freefall-css-cloud {
		0% {
			opacity: 0;
			transform: scale(0.08);
		}
		18%,
		72% {
			opacity: 0.32;
		}
		100% {
			opacity: 0;
			transform: scale(7.5);
		}
	}

	.fall-cloud-body {
		fill: var(--cream-light);
		stroke: var(--ink);
		stroke-width: 10;
		stroke-linejoin: round;
	}

	.fall-cloud-ink {
		fill: none;
		stroke: var(--orange);
		stroke-width: 8;
		stroke-linecap: round;
		opacity: 0.58;
	}

	.fall-cloud-pass--one {
		inset-block-start: 8%;
		inset-inline-start: 8%;
	}

	.fall-cloud-pass--two {
		inset-block-start: 9%;
		inset-inline-start: 63%;
		transform: scaleX(-1);
	}

	.fall-cloud-pass--three {
		inset-block-start: 66%;
		inset-inline-start: 8%;
		transform: rotate(-10deg);
	}

	.fall-cloud-pass--four {
		inset-block-start: 61%;
		inset-inline-start: 67%;
		transform: scaleX(-1) rotate(9deg);
	}

	.speed-burst {
		transform-origin: 50% 50%;
	}

	.speed-burst span {
		position: absolute;
		inset-block-start: calc(50% - 0.25rem);
		inset-inline-start: 50%;
		inline-size: 68vmax;
		block-size: clamp(0.16rem, 0.35vw, 0.35rem);
		background: linear-gradient(
			90deg,
			transparent 4%,
			var(--cream-light) 18% 72%,
			transparent 94%
		);
		transform-origin: 0 50%;
	}

	.speed-burst span:nth-child(1) {
		transform: rotate(5deg);
	}
	.speed-burst span:nth-child(2) {
		transform: rotate(34deg);
	}
	.speed-burst span:nth-child(3) {
		transform: rotate(62deg);
	}
	.speed-burst span:nth-child(4) {
		transform: rotate(93deg);
	}
	.speed-burst span:nth-child(5) {
		transform: rotate(124deg);
	}
	.speed-burst span:nth-child(6) {
		transform: rotate(153deg);
	}
	.speed-burst span:nth-child(7) {
		transform: rotate(184deg);
	}
	.speed-burst span:nth-child(8) {
		transform: rotate(214deg);
	}
	.speed-burst span:nth-child(9) {
		transform: rotate(244deg);
	}
	.speed-burst span:nth-child(10) {
		transform: rotate(274deg);
	}
	.speed-burst span:nth-child(11) {
		transform: rotate(304deg);
	}
	.speed-burst span:nth-child(12) {
		transform: rotate(334deg);
	}

	.freefall-intro:not([data-intro-owner='gsap']) .speed-burst {
		animation: freefall-css-speed 0.52s ease-in-out infinite alternate;
	}

	@keyframes freefall-css-speed {
		from {
			opacity: 0.2;
		}
		to {
			opacity: 0.48;
		}
	}

	.freefall-vignette {
		background:
			radial-gradient(
				circle at 50% 50%,
				transparent 0 14%,
				rgb(7 89 182 / 8%) 34%,
				rgb(6 28 56 / 46%) 100%
			),
			linear-gradient(115deg, rgb(255 242 211 / 7%), transparent 42%);
	}

	@media (max-width: 40rem) {
		.terrain-pass {
			inset: -8%;
			inline-size: 116%;
			block-size: 116%;
		}

		.fall-cloud-pass {
			inline-size: min(76vw, 20rem);
			block-size: min(33.44vw, 8.8rem);
		}

		.fall-cloud-pass--one {
			--fall-cloud-transform-origin: 98% 90%;
			inset-block-start: 6svh;
			inset-inline: auto 60%;
		}

		.fall-cloud-pass--two {
			--fall-cloud-transform-origin: 4% 90%;
			inset-block-start: 18svh;
			inset-inline-start: 60%;
			transform: none;
		}

		.fall-cloud-pass--three {
			--fall-cloud-transform-origin: 98% 35%;
			inset-block-start: 59svh;
			inset-inline: auto 60%;
			transform: none;
		}

		.fall-cloud-pass--four {
			--fall-cloud-transform-origin: 4% 35%;
			inset-block-start: 70svh;
			inset-inline-start: 60%;
			transform: none;
		}
	}

	@media (max-width: 64rem) {
		.terrain-far,
		.terrain-mid,
		.terrain-near,
		.fall-clouds {
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.freefall-intro:not([data-intro-owner='gsap']) {
			animation: freefall-intro-fallback-complete 0.45s ease-in-out 0.45s
				forwards;
		}

		.freefall-intro:not([data-intro-owner='gsap']) .terrain-pass,
		.freefall-intro:not([data-intro-owner='gsap']) .fall-cloud-pass,
		.freefall-intro:not([data-intro-owner='gsap']) .speed-burst {
			animation: none;
		}

		.terrain-camera picture:not(:first-child),
		.speed-burst {
			display: none;
		}

		.fall-cloud-pass {
			opacity: 0.72;
		}
	}
</style>
