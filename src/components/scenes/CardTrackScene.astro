---
interface CardDirection {
	title: string;
	line: string;
	artwork: string;
}

const cards = [
	{
		title: 'FREEFALL',
		line: 'Commit to the drop.',
		artwork: '/assets/cards/freefall.webp',
	},
	{
		title: 'AIRTIME',
		line: 'Make the impossible feel weightless.',
		artwork: '/assets/cards/airtime.webp',
	},
	{
		title: 'LINE',
		line: 'Choose it. Build it. Send it.',
		artwork: '/assets/cards/line.webp',
	},
	{
		title: 'GRIP',
		line: 'Precision over panic.',
		artwork: '/assets/cards/grip-climbing.webp',
	},
	{
		title: 'FLOW',
		line: 'Every move leads to the next.',
		artwork: '/assets/cards/flow.webp',
	},
	{
		title: 'SUMMIT',
		line: 'Finish higher than you started.',
		artwork: '/assets/cards/summit.webp',
	},
] satisfies CardDirection[];
---

<section
	class="scene card-sequence"
	data-card-scene
	aria-label="Scroll-driven extreme-sports cards"
>
	<div class="card-viewport" data-card-viewport>
		<ol class="card-track" data-card-track>
			{
				cards.map((card, index) => (
					<li class={`extreme-card extreme-card--${index + 1}`}>
						<article>
							<img
								class="card-artwork"
								data-card-artwork
								src={card.artwork}
								alt=""
								width="960"
								height="600"
								loading="lazy"
								decoding="async"
								draggable="false"
							/>
							<div class="card-grade" aria-hidden="true" />
							<span class="card-number" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div class="card-copy">
								<h2 class="comic-title">{card.title}</h2>
								<p>{card.line}</p>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	const FREEFALL_COMPLETE_EVENT = 'freefall:intro-complete';
	const cardWindow = window as Window & {
		__cardArtworkCleanup?: () => void;
		requestIdleCallback?: (
			callback: IdleRequestCallback,
			options?: IdleRequestOptions,
		) => number;
		cancelIdleCallback?: (handle: number) => void;
	};
	cardWindow.__cardArtworkCleanup?.();

	const initialiseCardArtwork = () => {
		const scene = document.querySelector<HTMLElement>('[data-card-scene]');
		const images = scene
			? Array.from(
					scene.querySelectorAll<HTMLImageElement>('[data-card-artwork]'),
				)
			: [];
		if (!scene || images.length === 0) return;

		let idleHandle = 0;
		let fallbackTimer = 0;
		let started = false;
		let observer: IntersectionObserver | undefined;

		const preloadAndDecode = () => {
			if (started) return;
			started = true;
			for (const image of images) {
				image.loading = 'eager';
				if (typeof image.decode === 'function')
					void image.decode().catch(() => {});
			}
			observer?.disconnect();
		};

		const schedulePreload = () => {
			if (started || idleHandle || fallbackTimer) return;
			if (typeof cardWindow.requestIdleCallback === 'function') {
				idleHandle = cardWindow.requestIdleCallback(
					() => {
						idleHandle = 0;
						preloadAndDecode();
					},
					{ timeout: 900 },
				);
				return;
			}
			fallbackTimer = window.setTimeout(() => {
				fallbackTimer = 0;
				preloadAndDecode();
			}, 120);
		};

		const intro = document.querySelector<HTMLElement>('[data-freefall-intro]');
		if (intro?.hidden) schedulePreload();
		else
			window.addEventListener(FREEFALL_COMPLETE_EVENT, schedulePreload, {
				once: true,
			});

		observer = new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting) preloadAndDecode();
			},
			{ rootMargin: '120% 0px', threshold: 0 },
		);
		observer.observe(scene);

		const cleanup = () => {
			window.removeEventListener(FREEFALL_COMPLETE_EVENT, schedulePreload);
			document.removeEventListener('astro:before-swap', cleanup);
			observer?.disconnect();
			if (idleHandle && typeof cardWindow.cancelIdleCallback === 'function') {
				cardWindow.cancelIdleCallback(idleHandle);
			}
			window.clearTimeout(fallbackTimer);
			if (cardWindow.__cardArtworkCleanup === cleanup) {
				delete cardWindow.__cardArtworkCleanup;
			}
		};

		document.addEventListener('astro:before-swap', cleanup, { once: true });
		cardWindow.__cardArtworkCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);
	};

	initialiseCardArtwork();
</script>

<style>
	.card-sequence {
		display: block;
		padding: 0;
		background: var(--cream);
	}

	.card-viewport {
		position: relative;
		display: flex;
		align-items: center;
		inline-size: 100%;
		block-size: 100vh;
		block-size: 100svh;
		overflow: hidden;
	}

	.card-track {
		display: flex;
		flex: none;
		gap: var(--card-gap);
		inline-size: max-content;
		padding: 0 var(--scene-gutter);
		margin: 0;
		list-style: none;
		user-select: none;
	}

	.extreme-card {
		position: relative;
		flex: 0 0 var(--card-inline-size);
		inline-size: var(--card-inline-size);
		block-size: var(--card-block-size);
		border: clamp(0.35rem, 0.6vw, 0.65rem) solid var(--ink);
		background: var(--ink);
		box-shadow:
			clamp(0.55rem, 1.1vw, 1rem) clamp(0.55rem, 1.1vw, 1rem) 0 var(--red),
			clamp(0.85rem, 1.5vw, 1.45rem) clamp(0.85rem, 1.5vw, 1.45rem) 0 var(--ink);
		clip-path: polygon(
			0 0,
			calc(100% - 2.2rem) 0,
			100% 2.2rem,
			100% 100%,
			2.2rem 100%,
			0 calc(100% - 2.2rem)
		);
	}

	article {
		position: relative;
		isolation: isolate;
		block-size: 100%;
		overflow: hidden;
	}

	.card-artwork,
	.card-grade {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
	}

	.card-artwork {
		z-index: -2;
		max-inline-size: none;
		object-fit: cover;
		filter: saturate(1.08) contrast(1.04);
		pointer-events: none;
	}

	.card-grade {
		z-index: -1;
		background:
			linear-gradient(
				180deg,
				rgb(6 28 56 / 12%) 15%,
				transparent 46%,
				rgb(6 28 56 / 92%) 100%
			),
			linear-gradient(105deg, rgb(226 40 34 / 18%), transparent 42%);
	}

	.card-number {
		position: absolute;
		inset-block-start: clamp(1rem, 2.5vw, 2rem);
		inset-inline-end: clamp(1rem, 2.5vw, 2rem);
		padding: 0.25rem 0.55rem;
		border: 0.18rem solid var(--ink);
		background: var(--yellow);
		color: var(--ink);
		font-family: Impact, sans-serif;
		font-size: clamp(1rem, 2.2vw, 1.7rem);
		letter-spacing: 0.08em;
		line-height: 1;
		transform: rotate(2deg);
	}

	.card-copy {
		position: absolute;
		inset-inline: clamp(1.2rem, 3.6vw, 3rem);
		inset-block-end: clamp(1.2rem, 3.6vw, 3rem);
		color: var(--cream-light);
	}

	h2 {
		font-size: clamp(3.8rem, 9vw, 8rem);
		line-height: 0.78;
		letter-spacing: -0.025em;
		-webkit-text-stroke: clamp(0.1rem, 0.23vw, 0.25rem) var(--ink);
		text-shadow: clamp(0.28rem, 0.6vw, 0.6rem) clamp(0.28rem, 0.6vw, 0.6rem) 0
			var(--red);
	}

	p {
		display: inline-block;
		max-inline-size: 32ch;
		margin-block-start: 1rem;
		padding: 0.55rem 0.75rem;
		background: var(--cream-light);
		color: var(--ink);
		font-size: clamp(0.95rem, 2vw, 1.35rem);
		font-weight: 800;
		line-height: 1.2;
	}

	.extreme-card--4 .card-artwork {
		object-position: center 35%;
	}

	@media (max-width: 40rem) {
		.extreme-card {
			block-size: min(60svh, calc(var(--card-inline-size) * 1.18));
			clip-path: polygon(
				0 0,
				calc(100% - 1.25rem) 0,
				100% 1.25rem,
				100% 100%,
				1.25rem 100%,
				0 calc(100% - 1.25rem)
			);
			box-shadow:
				0.45rem 0.45rem 0 var(--red),
				0.7rem 0.7rem 0 var(--ink);
		}

		.extreme-card--1 .card-artwork {
			object-position: 15% center;
		}

		.extreme-card--2 .card-artwork {
			object-position: left center;
		}

		.extreme-card--3 .card-artwork {
			object-position: 100% center;
		}

		.extreme-card--4 .card-artwork,
		.extreme-card--5 .card-artwork,
		.extreme-card--6 .card-artwork {
			object-position: 60% center;
		}

		.card-artwork {
			block-size: 60%;
		}

		h2 {
			font-size: clamp(3.6rem, 16vw, 5.2rem);
		}

		p {
			max-inline-size: 24ch;
		}
	}

	@media (max-width: 64rem) {
		.card-artwork {
			filter: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card-sequence {
			min-block-size: 0;
			padding: clamp(4rem, 9vh, 7rem) var(--scene-gutter);
		}

		.card-viewport {
			display: block;
			block-size: auto;
			overflow: visible;
		}

		.card-track {
			display: grid;
			gap: clamp(2rem, 6vh, 4rem);
			inline-size: min(100%, 52rem);
			padding: 0;
			margin-inline: auto;
		}

		.extreme-card {
			inline-size: 100%;
			block-size: min(72svh, 40rem);
		}
	}
</style>
