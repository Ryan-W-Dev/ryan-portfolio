---
interface CardDirection {
	title: string;
	line: string;
}

const cards = [
	{ title: 'FREEFALL', line: 'Commit to the drop.' },
	{ title: 'AIRTIME', line: 'Make the impossible feel weightless.' },
	{ title: 'LINE', line: 'Choose it. Build it. Send it.' },
	{ title: 'GRIP', line: 'Precision over panic.' },
	{ title: 'FLOW', line: 'Every move leads to the next.' },
	{ title: 'SUMMIT', line: 'Finish higher than you started.' },
] satisfies CardDirection[];
---

<section
	class="scene card-sequence"
	data-card-scene
	aria-label="Scroll-driven extreme-sports cards"
>
	<div class="card-viewport" data-card-viewport>
		<ol class="card-track" data-card-track>
			{
				cards.map((card) => (
					<li class="extreme-card">
						<article>
							<h2>{card.title}</h2>
							<p>{card.line}</p>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const CARD_TRACK_TRIGGER_ID = 'extreme-card-track';
	const FINAL_CARD_SETTLE_VIEWPORT_RATIO = 0.25;
	const FINAL_CARD_SETTLED_LABEL = 'final-card-settled';
	const VISOR_HANDOFF_LABEL = 'visor-handoff';

	const cardTrackWindow = window as Window & {
		__extremeCardTrackCleanup?: () => void;
	};

	cardTrackWindow.__extremeCardTrackCleanup?.();

	const initialiseCardTrack = () => {
		const scene = document.querySelector<HTMLElement>('[data-card-scene]');
		const viewport = scene?.querySelector<HTMLElement>('[data-card-viewport]');
		const track = scene?.querySelector<HTMLOListElement>('[data-card-track]');

		if (!scene || !viewport || !track) {
			return;
		}

		ScrollTrigger.getById(CARD_TRACK_TRIGGER_ID)?.kill();

		const horizontalTravel = () =>
			Math.max(0, track.scrollWidth - viewport.clientWidth);
		const finalCardSettleDistance = () =>
			Math.max(1, viewport.clientHeight * FINAL_CARD_SETTLE_VIEWPORT_RATIO);

		let context: gsap.Context | undefined;
		let timeline: gsap.core.Timeline | undefined;
		let resizeFrame: number | undefined;
		let disposed = false;

		const setTrackActive = (isActive: boolean) => {
			if (isActive) {
				track.style.willChange = 'transform';
				return;
			}

			track.style.removeProperty('will-change');
		};

		const revertTimeline = () => {
			setTrackActive(false);
			timeline?.scrollTrigger?.kill();
			timeline?.kill();
			timeline = undefined;
			context?.revert();
			context = undefined;
		};

		const buildTimeline = () => {
			revertTimeline();

			const travelDistance = horizontalTravel();
			const settleDistance = finalCardSettleDistance();
			const settleState = { progress: 0 };

			context = gsap.context(() => {
				gsap.set(track, { x: 0 });

				timeline = gsap
					.timeline({
						defaults: { ease: 'none' },
						scrollTrigger: {
							id: CARD_TRACK_TRIGGER_ID,
							trigger: scene,
							start: 'top top',
							end: `+=${Math.max(travelDistance + settleDistance, 1)}`,
							scrub: true,
							pin: true,
							anticipatePin: 1,
							invalidateOnRefresh: true,
							onEnter: () => setTrackActive(true),
							onEnterBack: () => setTrackActive(true),
							onLeave: () => setTrackActive(false),
							onLeaveBack: () => setTrackActive(false),
							onRefresh: (trigger) => setTrackActive(trigger.isActive),
						},
					})
					.to(track, {
						x: -travelDistance,
						duration: Math.max(travelDistance, 1),
					})
					.addLabel(FINAL_CARD_SETTLED_LABEL)
					.to(settleState, {
						progress: 1,
						duration: settleDistance,
					})
					.addLabel(VISOR_HANDOFF_LABEL);
			}, scene);
		};

		const handleResize = () => {
			if (disposed) {
				return;
			}

			if (resizeFrame !== undefined) {
				window.cancelAnimationFrame(resizeFrame);
			}

			resizeFrame = window.requestAnimationFrame(() => {
				resizeFrame = undefined;
				buildTimeline();
				ScrollTrigger.refresh();
			});
		};

		const cleanup = () => {
			if (disposed) {
				return;
			}

			disposed = true;
			window.removeEventListener('resize', handleResize);
			document.removeEventListener('astro:before-swap', cleanup);

			if (resizeFrame !== undefined) {
				window.cancelAnimationFrame(resizeFrame);
				resizeFrame = undefined;
			}

			revertTimeline();

			if (cardTrackWindow.__extremeCardTrackCleanup === cleanup) {
				delete cardTrackWindow.__extremeCardTrackCleanup;
			}
		};

		buildTimeline();
		window.addEventListener('resize', handleResize, { passive: true });
		document.addEventListener('astro:before-swap', cleanup, { once: true });

		cardTrackWindow.__extremeCardTrackCleanup = cleanup;
		import.meta.hot?.dispose(cleanup);

		ScrollTrigger.refresh();
	};

	initialiseCardTrack();
</script>

<style>
	.card-sequence {
		display: block;
		padding: 0;
		background: var(--color-surface);
	}

	.card-viewport {
		display: flex;
		align-items: center;
		inline-size: 100%;
		block-size: 100vh;
		block-size: 100svh;
		overflow: hidden;
	}

	.card-track {
		display: flex;
		flex: none;
		gap: var(--card-gap);
		inline-size: max-content;
		padding: 0 var(--scene-gutter);
		margin: 0;
		list-style: none;
	}

	.extreme-card {
		flex: 0 0 var(--card-inline-size);
		inline-size: var(--card-inline-size);
		block-size: var(--card-block-size);
		border: 1px solid var(--color-ink);
		background: var(--color-panel);
	}

	article {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		block-size: 100%;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	h2 {
		font-size: clamp(2.5rem, 7vw, 6rem);
		line-height: 0.9;
		letter-spacing: -0.055em;
	}

	p {
		max-inline-size: 28ch;
		font-size: clamp(1rem, 2vw, 1.5rem);
		line-height: 1.3;
	}
</style>
