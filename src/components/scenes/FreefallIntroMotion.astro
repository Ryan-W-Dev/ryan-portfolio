<script>
	import { gsap } from 'gsap';

	interface FreefallPass {
		target: HTMLElement;
		cycleDuration: number;
		initialPhase: number;
		startScale: number;
		endScale: number;
		maxOpacity: number;
		setScale: (value: number) => void;
		setOpacity: (value: number) => void;
	}

	const TOTAL_DURATION = 4;
	const HERO_HANDOFF_START = 3.35;
	const REDUCED_TOTAL_DURATION = 0.45;
	const REDUCED_HERO_HANDOFF_START = 0;
	const ASSET_READINESS_TIMEOUT_MS = 1500;
	const STARTUP_WATCHDOG_MS = 5250;
	const FALLBACK_DURATION_MS = 4300;
	const REDUCED_FALLBACK_DURATION_MS = 900;
	const FREEFALL_COMPLETE_EVENT = 'freefall:intro-complete';
	type IntroState =
		| 'pending'
		| 'initializing'
		| 'fallback'
		| 'playing'
		| 'completing'
		| 'complete'
		| 'recovered';
	type CompletionReason =
		| 'timeline'
		| 'watchdog'
		| 'missing-dom'
		| 'late-start'
		| 'initialization-failure';
	const freefallWindow = window as Window & {
		__freefallIntroCleanup?: () => void;
		__freefallIntroState?: IntroState;
	};

	try {
		freefallWindow.__freefallIntroCleanup?.();
	} catch {
		delete freefallWindow.__freefallIntroCleanup;
	}

	const opacityAt = (phase: number, maximum: number) => {
		const fade = 0.18;
		if (phase < fade) return maximum * (phase / fade);
		if (phase > 1 - fade) return maximum * ((1 - phase) / fade);
		return maximum;
	};

	let introState: IntroState = 'pending';
	let runtimeComplete: ((recovered: boolean) => void) | undefined;
	let runtimeFallback: (() => void) | undefined;
	let completionDispatched = false;
	let fallbackCompletionTimer = 0;
	const introStartedAt = performance.now();
	const debugIntroEnabled =
		import.meta.env.DEV &&
		new URLSearchParams(window.location.search).has('debugIntro');

	const setIntroState = (state: IntroState, intro?: HTMLElement | null) => {
		introState = state;
		freefallWindow.__freefallIntroState = state;
		const introRoot =
			intro ?? document.querySelector<HTMLElement>('[data-freefall-intro]');
		if (introRoot) introRoot.dataset.introState = state;
		if (debugIntroEnabled) {
			console.info(
				'[freefall-debug]',
				JSON.stringify({
					event: `state:${state}`,
					timestamp: Math.round(performance.now()),
				}),
			);
		}
	};

	const debugIntro = (event: string, details: Record<string, unknown> = {}) => {
		if (!debugIntroEnabled) return;
		console.info(
			'[freefall-debug]',
			JSON.stringify({
				event,
				state: introState,
				timestamp: Math.round(performance.now()),
				...details,
			}),
		);
	};
	debugIntro('script-initialized');

	const revealHeroContent = () => {
		document.documentElement.removeAttribute('data-intro-pending');
		const arrival = document.querySelector<HTMLElement>('[data-arrival-scene]');
		arrival?.setAttribute('data-intro-complete', '');
		for (const element of [
			arrival?.querySelector<HTMLElement>('[data-arrival-title]'),
			arrival?.querySelector<HTMLElement>('[data-arrival-subtitle]'),
			arrival?.querySelector<HTMLElement>('[data-scroll-indicator]'),
		]) {
			if (!element) continue;
			for (const property of [
				'opacity',
				'visibility',
				'transform',
				'translate',
				'rotate',
				'scale',
				'will-change',
			]) {
				element.style.removeProperty(property);
			}
		}
	};

	const emergencyRelease = () => {
		const intro = document.querySelector<HTMLElement>('[data-freefall-intro]');
		intro?.setAttribute('hidden', '');
		if (intro) delete intro.dataset.introOwner;
		document.documentElement.style.removeProperty('overflow');
		document.documentElement.style.removeProperty('scrollbar-gutter');
		document.body.style.removeProperty('overflow');
		document.body.style.removeProperty('touch-action');
		history.scrollRestoration = 'auto';
		revealHeroContent();
	};

	const completeIntro = (
		reason: CompletionReason,
		recovered = reason !== 'timeline',
	) => {
		if (completionDispatched) return;
		completionDispatched = true;
		window.clearTimeout(fallbackCompletionTimer);
		fallbackCompletionTimer = 0;
		setIntroState('completing');
		debugIntro('completion-requested', { reason, recovered });
		if (recovered) debugIntro('recovery-activated', { reason });
		try {
			if (runtimeComplete) runtimeComplete(recovered);
			else emergencyRelease();
		} catch {
			emergencyRelease();
			recovered = true;
		} finally {
			debugIntro('hero-revealed', { reason, recovered });
			setIntroState(recovered ? 'recovered' : 'complete');
			window.dispatchEvent(new Event(FREEFALL_COMPLETE_EVENT));
		}
	};

	const scheduleFallbackCompletion = (reason: CompletionReason) => {
		if (completionDispatched || fallbackCompletionTimer) return;
		setIntroState('fallback');
		try {
			runtimeFallback?.();
		} catch {
			// The CSS-owned first frame remains available even if partial GSAP cleanup fails.
		}
		const intro = document.querySelector<HTMLElement>('[data-freefall-intro]');
		if (intro) {
			intro.hidden = false;
			delete intro.dataset.introOwner;
		}
		const fallbackDuration = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches
			? REDUCED_FALLBACK_DURATION_MS
			: FALLBACK_DURATION_MS;
		const remaining = Math.max(
			100,
			fallbackDuration - (performance.now() - introStartedAt),
		);
		debugIntro('fallback-scheduled', {
			reason,
			remaining: Math.round(remaining),
		});
		fallbackCompletionTimer = window.setTimeout(() => {
			fallbackCompletionTimer = 0;
			completeIntro(reason, true);
		}, remaining);
	};

	const initialiseFreefallIntro = () => {
		const intro = document.querySelector<HTMLElement>('[data-freefall-intro]');
		const world = intro?.querySelector<HTMLElement>('[data-freefall-world]');
		const terrainCamera = intro?.querySelector<HTMLElement>(
			'[data-terrain-camera]',
		);
		const arrival = document.querySelector<HTMLElement>('[data-arrival-scene]');
		const heroImage = arrival?.querySelector<HTMLImageElement>(
			'[data-hero-landscape]',
		);
		const title = arrival?.querySelector<HTMLElement>('[data-arrival-title]');
		const subtitle = arrival?.querySelector<HTMLElement>(
			'[data-arrival-subtitle]',
		);
		const indicator = arrival?.querySelector<HTMLElement>(
			'[data-scroll-indicator]',
		);
		const passElements = intro
			? Array.from(intro.querySelectorAll<HTMLElement>('[data-depth-family]'))
			: [];
		const original = {
			rootOverflow: document.documentElement.style.overflow,
			rootGutter:
				document.documentElement.style.getPropertyValue('scrollbar-gutter'),
			bodyOverflow: document.body.style.overflow,
			bodyTouchAction: document.body.style.touchAction,
			scrollRestoration: history.scrollRestoration,
		};
		const imageWaitResolvers = new Set<() => void>();
		let context: gsap.Context | undefined;
		let timeline: gsap.core.Timeline | undefined;
		let startupWatchdog = 0;
		let watchdogRemaining = STARTUP_WATCHDOG_MS;
		let watchdogStartedAt = 0;
		let assetReadinessTimer = 0;
		let settled = false;
		let timelineStarted = false;
		let pausedForVisibility = false;

		const clearImageWaiters = () => {
			for (const resolve of [...imageWaitResolvers]) resolve();
			imageWaitResolvers.clear();
		};

		const pauseWatchdog = () => {
			if (!startupWatchdog) return;
			window.clearTimeout(startupWatchdog);
			startupWatchdog = 0;
			watchdogRemaining = Math.max(
				0,
				watchdogRemaining - (performance.now() - watchdogStartedAt),
			);
			debugIntro('watchdog-paused', {
				remaining: Math.round(watchdogRemaining),
			});
		};

		const armWatchdog = () => {
			if (settled || document.hidden || startupWatchdog) return;
			if (watchdogRemaining <= 0) {
				completeIntro('watchdog');
				return;
			}
			watchdogStartedAt = performance.now();
			startupWatchdog = window.setTimeout(() => {
				startupWatchdog = 0;
				watchdogRemaining = 0;
				completeIntro('watchdog');
			}, watchdogRemaining);
			debugIntro('watchdog-armed', {
				remaining: Math.round(watchdogRemaining),
			});
		};

		const clearTimers = () => {
			window.clearTimeout(startupWatchdog);
			window.clearTimeout(assetReadinessTimer);
			startupWatchdog = 0;
			assetReadinessTimer = 0;
			clearImageWaiters();
		};

		const restorePage = () => {
			document.documentElement.style.overflow = original.rootOverflow;
			if (original.rootGutter) {
				document.documentElement.style.setProperty(
					'scrollbar-gutter',
					original.rootGutter,
				);
			} else {
				document.documentElement.style.removeProperty('scrollbar-gutter');
			}
			document.body.style.overflow = original.bodyOverflow;
			document.body.style.touchAction = original.bodyTouchAction;
			history.scrollRestoration = original.scrollRestoration;
			window.scrollTo(0, 0);
		};

		const removeLifecycleListeners = () => {
			document.removeEventListener('visibilitychange', handleVisibility);
			document.removeEventListener('astro:before-swap', handleSwap);
			window.removeEventListener('pageshow', handlePageShow);
			window.removeEventListener('focus', handleFocus);
		};

		const releaseRuntime = (completed: boolean) => {
			if (settled) return;
			settled = true;
			clearTimers();
			removeLifecycleListeners();
			try {
				timeline?.kill();
			} catch {
				// Cleanup must continue even if GSAP has already torn itself down.
			}
			try {
				context?.revert();
			} catch {
				// The page unlock and hero reveal remain mandatory.
			}
			timeline = undefined;
			context = undefined;
			if (intro) {
				delete intro.dataset.introOwner;
				intro.hidden = true;
			}
			try {
				restorePage();
			} catch {
				document.documentElement.style.removeProperty('overflow');
				document.documentElement.style.removeProperty('scrollbar-gutter');
				document.body.style.removeProperty('overflow');
				document.body.style.removeProperty('touch-action');
			}
			if (completed) revealHeroContent();
			if (freefallWindow.__freefallIntroCleanup === handleCleanup) {
				delete freefallWindow.__freefallIntroCleanup;
			}
			if (runtimeComplete === handleComplete) runtimeComplete = undefined;
			if (runtimeFallback === handleFallback) runtimeFallback = undefined;
		};

		const handleComplete = () => releaseRuntime(true);
		const handleFallback = () => {
			clearTimers();
			try {
				timeline?.kill();
				context?.revert();
			} catch {
				// CSS owns the recovery frame after the GSAP owner flag is removed.
			}
			timeline = undefined;
			context = undefined;
		};
		const handleCleanup = () => releaseRuntime(false);
		const handleSwap = () => handleCleanup();

		const resumeRuntime = (source: 'visibility' | 'pageshow' | 'focus') => {
			if (settled || document.hidden) return;
			debugIntro('lifecycle-resume', { source });
			armWatchdog();
			if (timeline && timelineStarted && pausedForVisibility) {
				pausedForVisibility = false;
				timeline.resume();
			}
		};

		const handleVisibility = () => {
			if (settled) return;
			if (document.hidden) {
				debugIntro('visibility-hidden');
				pauseWatchdog();
				if (timeline && timelineStarted && !timeline.paused()) {
					pausedForVisibility = true;
					timeline.pause();
				}
				return;
			}
			resumeRuntime('visibility');
		};

		const handlePageShow = () => resumeRuntime('pageshow');
		const handleFocus = () => resumeRuntime('focus');

		const waitForImage = async (image: HTMLImageElement) => {
			if (!image.complete) {
				await new Promise<void>((resolve) => {
					const settle = () => {
						image.removeEventListener('load', settle);
						image.removeEventListener('error', settle);
						imageWaitResolvers.delete(settle);
						resolve();
					};
					imageWaitResolvers.add(settle);
					image.addEventListener('load', settle, { once: true });
					image.addEventListener('error', settle, { once: true });
				});
			}

			if (image.naturalWidth === 0 || typeof image.decode !== 'function')
				return;
			try {
				await image.decode();
			} catch {
				// Decoding is an optimization; load or decode failure must never block entry.
			}
		};

		const waitForArtwork = async () => {
			if (!intro || !heroImage) return 'unavailable' as const;
			const uniqueImages = new Map<string, HTMLImageElement>();
			for (const image of [
				...Array.from(intro.querySelectorAll<HTMLImageElement>('img')),
				heroImage,
			]) {
				const source =
					image.currentSrc || image.getAttribute('src') || image.src;
				if (!uniqueImages.has(source)) uniqueImages.set(source, image);
			}

			const readiness = await Promise.race([
				Promise.all([...uniqueImages.values()].map(waitForImage)).then(
					() => 'ready' as const,
				),
				new Promise<'timeout'>((resolve) => {
					assetReadinessTimer = window.setTimeout(() => {
						assetReadinessTimer = 0;
						clearImageWaiters();
						resolve('timeout');
					}, ASSET_READINESS_TIMEOUT_MS);
				}),
			]);
			window.clearTimeout(assetReadinessTimer);
			assetReadinessTimer = 0;
			clearImageWaiters();
			debugIntro(`assets-${readiness}`);
			return readiness;
		};

		const start = async () => {
			document.addEventListener('visibilitychange', handleVisibility);
			document.addEventListener('astro:before-swap', handleSwap, {
				once: true,
			});
			window.addEventListener('pageshow', handlePageShow);
			window.addEventListener('focus', handleFocus);
			setIntroState('initializing', intro);
			debugIntro('initialization-start');
			armWatchdog();

			if (
				!intro ||
				!world ||
				!terrainCamera ||
				!arrival ||
				!heroImage ||
				!title ||
				!subtitle ||
				!indicator ||
				passElements.length === 0
			) {
				scheduleFallbackCompletion('missing-dom');
				return;
			}

			intro.hidden = false;
			delete intro.dataset.introOwner;
			delete arrival.dataset.introComplete;
			document.documentElement.style.overflow = 'hidden';
			if (
				window.innerWidth >= 768 &&
				CSS.supports('scrollbar-gutter', 'stable')
			) {
				document.documentElement.style.setProperty(
					'scrollbar-gutter',
					'stable',
				);
			}
			document.body.style.overflow = 'hidden';
			document.body.style.touchAction = 'none';
			history.scrollRestoration = 'manual';
			window.scrollTo(0, 0);
			if (performance.now() - introStartedAt > 350) {
				scheduleFallbackCompletion('late-start');
				return;
			}

			void waitForArtwork();

			const reducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)',
			).matches;
			const runDuration = reducedMotion
				? REDUCED_TOTAL_DURATION
				: TOTAL_DURATION;
			const handoffStart = reducedMotion
				? REDUCED_HERO_HANDOFF_START
				: HERO_HANDOFF_START;

			context = gsap.context(() => {
				gsap.set(terrainCamera, {
					clearProps: 'transform',
					willChange: 'auto',
				});
				gsap.set(world, {
					autoAlpha: 1,
					'--hero-reveal': '0%',
					willChange: 'mask-image, -webkit-mask-image',
				});
				gsap.set(title, {
					autoAlpha: 0,
					yPercent: 8,
					scale: 0.95,
					willChange: 'transform, opacity',
				});
				gsap.set([subtitle, indicator], {
					autoAlpha: 0,
					willChange: 'opacity',
				});

				const passes: FreefallPass[] = passElements.map((target) => {
					const family = target.dataset.depthFamily;
					const initialPhase = Number(target.dataset.initialPhase ?? 0);
					const settings =
						family === 'terrain-far'
							? {
									cycleDuration: 1.45,
									startScale: 0.58,
									endScale: reducedMotion ? 1.18 : 1.35,
									maxOpacity: 0.24,
								}
							: family === 'terrain-mid'
								? {
										cycleDuration: 1.05,
										startScale: 0.38,
										endScale: reducedMotion ? 1.22 : 1.65,
										maxOpacity: 0.18,
									}
								: family === 'terrain-near'
									? {
											cycleDuration: 0.78,
											startScale: 0.2,
											endScale: reducedMotion ? 1.3 : 2,
											maxOpacity: 0.14,
										}
									: family === 'cloud'
										? {
												cycleDuration: 6,
												startScale: 0.65,
												endScale: 1.65,
												maxOpacity: 0.22,
											}
										: {
												cycleDuration: 0.52,
												startScale: 0.55,
												endScale: reducedMotion ? 1.15 : 2.7,
												maxOpacity: 0.34,
											};

					gsap.set(target, {
						willChange: 'transform, opacity',
					});
					return {
						target,
						initialPhase,
						...settings,
						setScale: gsap.quickSetter(target, '--pass-scale') as (
							value: number,
						) => void,
						setOpacity: gsap.quickSetter(target, 'opacity') as (
							value: number,
						) => void,
					};
				});

				const renderPasses = (elapsed: number) => {
					passes.forEach((pass) => {
						const phase =
							(pass.initialPhase +
								(reducedMotion ? 0 : elapsed / pass.cycleDuration)) %
							1;
						pass.setScale(
							pass.startScale + (pass.endScale - pass.startScale) * phase,
						);
						pass.setOpacity(opacityAt(phase, pass.maxOpacity));
					});
				};

				const clock = { elapsed: 0 };
				// Establish the shared pass origin before the first-paint gate reveals the world.
				renderPasses(0);

				timeline = gsap.timeline({
					paused: true,
					onComplete: () => completeIntro('timeline'),
				});
				if (reducedMotion) {
					timeline
						.addLabel('reduced-static-frame', 0)
						.to(
							intro,
							{
								autoAlpha: 0,
								duration: REDUCED_TOTAL_DURATION,
								ease: 'power1.inOut',
							},
							0,
						)
						.addLabel('intro-complete', REDUCED_TOTAL_DURATION);
				} else {
					timeline
						.addLabel('terminal-velocity', 0)
						.to(
							clock,
							{
								elapsed: runDuration,
								duration: runDuration,
								ease: 'none',
								onUpdate: () => renderPasses(clock.elapsed),
							},
							0,
						)
						.addLabel('hero-handoff', handoffStart)
						.to(
							world,
							{
								'--hero-reveal': '150%',
								duration: runDuration - handoffStart,
								ease: 'power3.inOut',
							},
							handoffStart,
						)
						.to(
							title,
							{
								autoAlpha: 1,
								yPercent: 0,
								scale: 1,
								duration: 0.48,
								ease: 'power3.out',
							},
							handoffStart + 0.11,
						)
						.to(
							[subtitle, indicator],
							{
								autoAlpha: 1,
								duration: 0.26,
								ease: 'power2.out',
							},
							handoffStart + 0.38,
						)
						.addLabel('intro-complete', runDuration);
				}

				timeline.totalTime(0, true);
			}, intro);

			void world.getBoundingClientRect();
			intro.dataset.introOwner = 'gsap';
			setIntroState('playing', intro);
			debugIntro('first-visible-frame', {
				reducedMotion,
				timelineTime: timeline?.time() ?? null,
			});
			requestAnimationFrame(() => {
				if (settled) return;
				timelineStarted = true;
				debugIntro('timeline-start', {
					documentHidden: document.hidden,
				});
				if (document.hidden) {
					pausedForVisibility = true;
				} else {
					timeline?.play();
				}
			});
		};

		freefallWindow.__freefallIntroCleanup = handleCleanup;
		runtimeComplete = handleComplete;
		runtimeFallback = handleFallback;
		import.meta.hot?.dispose(handleCleanup);
		void start().catch((error: unknown) => {
			debugIntro('initialization-error', {
				message: error instanceof Error ? error.message : String(error),
			});
			scheduleFallbackCompletion('initialization-failure');
		});
	};

	try {
		initialiseFreefallIntro();
	} catch (error) {
		debugIntro('initialization-error', {
			message: error instanceof Error ? error.message : String(error),
		});
		scheduleFallbackCompletion('initialization-failure');
	}
</script>
