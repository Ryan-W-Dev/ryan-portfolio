<script>
	import { gsap } from 'gsap';

	interface FreefallPass {
		target: HTMLElement;
		cycleDuration: number;
		initialPhase: number;
		startScale: number;
		endScale: number;
		maxOpacity: number;
		setScale: (value: number) => void;
		setOpacity: (value: number) => void;
	}

	const TOTAL_DURATION = 4;
	const HERO_HANDOFF_START = 3.35;
	const FREEFALL_COMPLETE_EVENT = 'freefall:intro-complete';
	const freefallWindow = window as Window & {
		__freefallIntroCleanup?: () => void;
	};

	freefallWindow.__freefallIntroCleanup?.();

	const opacityAt = (phase: number, maximum: number) => {
		const fade = 0.18;
		if (phase < fade) return maximum * (phase / fade);
		if (phase > 1 - fade) return maximum * ((1 - phase) / fade);
		return maximum;
	};

	const initialiseFreefallIntro = async () => {
		const intro = document.querySelector<HTMLElement>('[data-freefall-intro]');
		const world = intro?.querySelector<HTMLElement>('[data-freefall-world]');
		const terrainCamera = intro?.querySelector<HTMLElement>(
			'[data-terrain-camera]',
		);
		const arrival = document.querySelector<HTMLElement>('[data-arrival-scene]');
		const heroImage = arrival?.querySelector<HTMLImageElement>(
			'[data-hero-landscape]',
		);
		const title = arrival?.querySelector<HTMLElement>('[data-arrival-title]');
		const subtitle = arrival?.querySelector<HTMLElement>(
			'[data-arrival-subtitle]',
		);
		const indicator = arrival?.querySelector<HTMLElement>(
			'[data-scroll-indicator]',
		);
		const passElements = intro
			? Array.from(intro.querySelectorAll<HTMLElement>('[data-depth-family]'))
			: [];

		if (
			!intro ||
			!world ||
			!terrainCamera ||
			!arrival ||
			!heroImage ||
			!title ||
			!subtitle ||
			!indicator ||
			passElements.length === 0
		) {
			intro?.setAttribute('hidden', '');
			arrival?.setAttribute('data-intro-complete', '');
			return;
		}

		intro.hidden = false;
		delete intro.dataset.sequenceReady;
		delete arrival.dataset.introComplete;

		const original = {
			rootOverflow: document.documentElement.style.overflow,
			rootGutter: document.documentElement.style.scrollbarGutter,
			bodyOverflow: document.body.style.overflow,
			bodyTouchAction: document.body.style.touchAction,
			scrollRestoration: history.scrollRestoration,
		};

		document.documentElement.style.overflow = 'hidden';
		document.documentElement.style.scrollbarGutter =
			window.innerWidth >= 768 ? 'stable' : 'auto';
		document.body.style.overflow = 'hidden';
		document.body.style.touchAction = 'none';
		history.scrollRestoration = 'manual';
		window.scrollTo(0, 0);

		const artwork = [
			...Array.from(intro.querySelectorAll<HTMLImageElement>('img')),
			heroImage,
		];
		await Promise.all(
			artwork.map(async (image) => {
				try {
					if (!image.complete) {
						await new Promise<void>((resolve) => {
							image.addEventListener('load', () => resolve(), { once: true });
							image.addEventListener('error', () => resolve(), { once: true });
						});
					}
					await image.decode();
				} catch {
					// The timed sequence still completes if a decoded derivative is unavailable.
				}
			}),
		);

		const reducedMotion = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;
		let context: gsap.Context | undefined;
		let timeline: gsap.core.Timeline | undefined;
		let disposed = false;
		let pausedForVisibility = false;

		const restorePage = () => {
			document.documentElement.style.overflow = original.rootOverflow;
			document.documentElement.style.scrollbarGutter = original.rootGutter;
			document.body.style.overflow = original.bodyOverflow;
			document.body.style.touchAction = original.bodyTouchAction;
			history.scrollRestoration = original.scrollRestoration;
			window.scrollTo(0, 0);
		};

		const handleVisibility = () => {
			if (!timeline || disposed) return;
			if (document.hidden && !timeline.paused()) {
				pausedForVisibility = true;
				timeline.pause();
			} else if (!document.hidden && pausedForVisibility) {
				pausedForVisibility = false;
				timeline.resume();
			}
		};

		const cleanup = (completed = false) => {
			if (disposed) return;
			disposed = true;
			document.removeEventListener('visibilitychange', handleVisibility);
			document.removeEventListener('astro:before-swap', handleSwap);
			timeline?.kill();
			intro.hidden = true;
			context?.revert();
			timeline = undefined;
			context = undefined;
			delete intro.dataset.sequenceReady;
			restorePage();
			if (completed) arrival.dataset.introComplete = '';
			if (freefallWindow.__freefallIntroCleanup === handleCleanup) {
				delete freefallWindow.__freefallIntroCleanup;
			}
		};

		const handleCleanup = () => cleanup(false);
		const handleSwap = () => cleanup(false);
		const complete = () => {
			arrival.dataset.introComplete = '';
			cleanup(true);
			window.dispatchEvent(new Event(FREEFALL_COMPLETE_EVENT));
		};

		context = gsap.context(() => {
			gsap.set(terrainCamera, { clearProps: 'transform', willChange: 'auto' });
			gsap.set(world, {
				autoAlpha: 1,
				'--hero-reveal': '0%',
				willChange: 'mask-image, -webkit-mask-image',
			});
			gsap.set(title, {
				autoAlpha: 0,
				yPercent: 8,
				scale: 0.95,
				willChange: 'transform, opacity',
			});
			gsap.set([subtitle, indicator], { autoAlpha: 0, willChange: 'opacity' });

			const passes: FreefallPass[] = passElements.map((target) => {
				const family = target.dataset.depthFamily;
				const initialPhase = Number(target.dataset.initialPhase ?? 0);
				const settings =
					family === 'terrain-far'
						? {
								cycleDuration: 1.45,
								startScale: 0.58,
								endScale: reducedMotion ? 1.18 : 3.6,
								maxOpacity: 0.72,
							}
						: family === 'terrain-mid'
							? {
									cycleDuration: 1.05,
									startScale: 0.38,
									endScale: reducedMotion ? 1.22 : 5.4,
									maxOpacity: 0.66,
								}
							: family === 'terrain-near'
								? {
										cycleDuration: 0.78,
										startScale: 0.2,
										endScale: reducedMotion ? 1.3 : 7.2,
										maxOpacity: 0.54,
									}
								: family === 'cloud'
									? {
											cycleDuration: 0.68,
											startScale: 0.08,
											endScale: reducedMotion ? 1.25 : 8.5,
											maxOpacity: 0.32,
										}
									: {
											cycleDuration: 0.52,
											startScale: 0.55,
											endScale: reducedMotion ? 1.15 : 2.7,
											maxOpacity: 0.34,
										};

				gsap.set(target, {
					transformOrigin: '50% 50%',
					willChange: 'transform, opacity',
				});
				return {
					target,
					initialPhase,
					...settings,
					setScale: gsap.quickSetter(target, 'scale') as (
						value: number,
					) => void,
					setOpacity: gsap.quickSetter(target, 'opacity') as (
						value: number,
					) => void,
				};
			});

			const renderPasses = (elapsed: number) => {
				passes.forEach((pass) => {
					const phase = (pass.initialPhase + elapsed / pass.cycleDuration) % 1;
					pass.setScale(
						pass.startScale + (pass.endScale - pass.startScale) * phase,
					);
					pass.setOpacity(opacityAt(phase, pass.maxOpacity));
				});
			};

			const clock = { elapsed: 0 };
			renderPasses(0);

			timeline = gsap.timeline({ paused: true, onComplete: complete });
			timeline
				.addLabel('terminal-velocity', 0)
				.to(
					clock,
					{
						elapsed: TOTAL_DURATION,
						duration: TOTAL_DURATION,
						ease: 'none',
						onUpdate: () => renderPasses(clock.elapsed),
					},
					0,
				)
				.addLabel('hero-handoff', HERO_HANDOFF_START)
				.to(
					world,
					{
						'--hero-reveal': '150%',
						duration: TOTAL_DURATION - HERO_HANDOFF_START,
						ease: 'power3.inOut',
					},
					HERO_HANDOFF_START,
				)
				.to(
					title,
					{
						autoAlpha: 1,
						yPercent: 0,
						scale: 1,
						duration: 0.48,
						ease: 'power3.out',
					},
					HERO_HANDOFF_START + 0.11,
				)
				.to(
					[subtitle, indicator],
					{
						autoAlpha: 1,
						duration: 0.26,
						ease: 'power2.out',
					},
					HERO_HANDOFF_START + 0.38,
				)
				.addLabel('intro-complete', TOTAL_DURATION);

			timeline.totalTime(0, true);
		}, intro);

		document.addEventListener('visibilitychange', handleVisibility);
		document.addEventListener('astro:before-swap', handleSwap, { once: true });
		freefallWindow.__freefallIntroCleanup = handleCleanup;
		import.meta.hot?.dispose(handleCleanup);

		void world.getBoundingClientRect();
		intro.dataset.sequenceReady = '';
		requestAnimationFrame(() => {
			if (document.hidden) pausedForVisibility = true;
			else timeline?.play();
		});
	};

	void initialiseFreefallIntro();
</script>
